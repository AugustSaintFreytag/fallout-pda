    </rect>

    <!-- Bottom Buttons Section -->
    <rect name="SD_BD_BottomButtons">
        <!-- Positioning the buttons -->
        <x>
            <copy src="me" trait="width"/>
            <div>2</div>
        </x>
        <y>
            <copy src="parent" trait="height"/>
            <mul>0.85</mul>
        </y>
        <width><copy src="parent" trait="width"/></width>
        <height>
            <copy src="parent" trait="height"/>
            <sub src="me" trait="y"/>
        </height>
        <locus>&true;</locus>
        <depth>3</depth>

        <!-- Shared values for buttons -->
        <_verticalPadding>15</_verticalPadding>
        <_horizontalPadding>15</_horizontalPadding>
        <_fontSize>1</_fontSize>
        <_justify>&center;</_justify>

        <!-- Confirm Button -->
        <hotrect name="SD_BD_ConfirmButton">
            <visible>1</visible>
            <include src="text_box.xml"/>
            <string>Confirm</string>
            <font><copy src="parent" trait="_fontSize"/></font>
            <justify>&center;</justify>
            <_verbuf><copy src="parent" trait="_verticalPadding"/></_verbuf>
            <_horbuf><copy src="parent" trait="_horizontalPadding"/></_horbuf>
        </hotrect>
    </rect>

    <!-- Shared values for the entire menu -->
    <_sidePadding>16</_sidePadding>
</rect>