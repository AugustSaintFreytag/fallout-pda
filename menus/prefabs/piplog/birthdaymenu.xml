            </x>
            <y>
                <copy src="sibling(SD_BD_YearString)" trait="y"/>
                <sub>
                    <copy src="sibling(SD_BD_YearString)" trait="height"/>
                    <div>2</div>
                </sub>
            </y>
            <width><copy src="parent" trait="_arrowWidth"/></width>
            <height>
                <copy src="sibling(SD_BD_YearString)" trait="height"/>
