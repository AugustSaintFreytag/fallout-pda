                    </add>
                </brightness>
            </image>
        </hotrect>

        <!-- Day Right Arrow -->
        <hotrect name="SD_BD_DayRightArrow">
            <x>
                <copy src="parent" trait="width"/>
                <div>2</div>
                <add src="parent" trait="_x_inc"/>
            </x>
            <y><copy src="sibling(SD_BD_DayLeftArrow)" trait="y"/></y>
            <width><copy src="parent" trait="_arrowWidth"/></width>
            <height><copy src="sibling(SD_BD_DayLeftArrow)" trait="height"/></height>
            <target>1</target>
            <locus>1</locus>
            <clicksound><copy src="parent" trait="_arrowClickSound"/></clicksound>
            <mouseoversound><copy src="parent" trait="_arrowMouseOverSound"/></mouseoversound>
            <image name="SD_BD_DayRightArrow_t">
                <filename>Interface\Main\main_arrow_right.dds</filename>
                <width><copy src="parent" trait="width"/></width>
                <height><copy src="parent" trait="height"/></height>
                <zoom>&scale;</zoom>
                <brightness>
                    <copy>210</copy>
                    <add>
