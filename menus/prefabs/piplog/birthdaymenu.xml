            </height>
            <target>1</target>
            <locus>1</locus>
            <clicksound><copy src="parent" trait="_arrowClickSound"/></clicksound>
            <mouseoversound><copy src="parent" trait="_arrowMouseOverSound"/></mouseoversound>
            <image name="SD_BD_YearLeftArrow_t">
                <filename>Interface\Main\main_arrow_left.dds</filename>
                <width><copy src="parent" trait="width"/></width>
                <height><copy src="parent" trait="height"/></height>
                <zoom>&scale;</zoom>
                <brightness>
                    <copy>210</copy>
                    <add>
                        <copy src="globals" trait="_VUI+Highlighting"/>
                        <mul>2</mul>
                        <onlyif src="parent" trait="mouseover"/>
                    </add>
                </brightness>
            </image>
        </hotrect>

        <!-- Right Arrows -->
        <!-- Month Right Arrow -->
        <hotrect name="SD_BD_MonthRightArrow">
            <x>
                <copy src="parent" trait="width"/>
                <div>2</div>
                <add src="parent" trait="_x_inc"/>
            </x>
            <y><copy src="sibling(SD_BD_MonthLeftArrow)" trait="y"/></y>
            <width><copy src="parent" trait="_arrowWidth"/></width>
            <height><copy src="sibling(SD_BD_MonthLeftArrow)" trait="height"/></height>
            <target>1</target>
            <locus>1</locus>
            <clicksound><copy src="parent" trait="_arrowClickSound"/></clicksound>
            <mouseoversound><copy src="parent" trait="_arrowMouseOverSound"/></mouseoversound>
            <image name="SD_BD_MonthRightArrow_t">
                <filename>Interface\Main\main_arrow_right.dds</filename>
                <width><copy src="parent" trait="width"/></width>
                <height><copy src="parent" trait="height"/></height>
                <zoom>&scale;</zoom>
                <brightness>
                    <copy>210</copy>
                    <add>
                        <copy src="globals" trait="_VUI+Highlighting"/>
                        <mul>2</mul>
