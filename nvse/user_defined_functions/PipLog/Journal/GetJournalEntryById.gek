begin function { string_var sId }

	; Returns the decoded journal entry with id sId.
	; Adds transient "_index" with the current storage index.
	; Returns Ar_Null if no entry matches.

	; UDFs

	ref DecodeJournalEntryFromStringUDF = CompileScript "PipLog\Journal\DecodeJournalEntryFromString.gek"

	; State

	array_var aEncodedEntries = Player.AuxiliaryVariableGetAsArray "PLC_aPlayerJournal"
	short iIndex = 0
	short iNumEntries = Ar_Size aEncodedEntries

	; Main

	if eval (Sv_Length sId) == 0
		let aEncodedEntries := Ar_Null
		SetFunctionValue Ar_Null
		return
	endif

	if iNumEntries == -1
		let aEncodedEntries := Ar_Null
		SetFunctionValue Ar_Null
		return
	endif

	while iIndex < iNumEntries
		string_var sEncodedEntry = aEncodedEntries[iIndex]
		array_var aJournalEntry = (Call DecodeJournalEntryFromStringUDF sEncodedEntry)

		if eval (Ar_Size aJournalEntry) != -1
			string_var sJournalEntryId = aJournalEntry["id"]

			if eval sJournalEntryId == sId
				let aJournalEntry["_index"] := iIndex

				SetFunctionValue aJournalEntry

				Sv_Destruct sEncodedEntry, sJournalEntryId
				let aEncodedEntries := Ar_Null

				return
			endif

			Sv_Destruct sJournalEntryId
		endif

		Sv_Destruct sEncodedEntry
		let aJournalEntry := Ar_Null
		let iIndex += 1
	loop

	SetFunctionValue Ar_Null

	; Clean-Up

	let aEncodedEntries := Ar_Null

end
