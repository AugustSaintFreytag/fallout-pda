begin function { array_var aJournalEntry }

	; Takes a stringmap with fields "id", "flags", "datetime", "location", and "text".
	; Returns the journal entry encoded as a "@@@"-delimited string.
	; Caller is responsible for Sv_Destruct on the returned string.

	; Main

	array_var aComponents = Ar_List aJournalEntry["id"], aJournalEntry["flags"], aJournalEntry["datetime"], aJournalEntry["location"], aJournalEntry["text"]
	string_var sEncodedEntry = Sv_Join aComponents "@@@"

	SetFunctionValue sEncodedEntry

	; Clean-Up

	let aComponents := Ar_Null

end
