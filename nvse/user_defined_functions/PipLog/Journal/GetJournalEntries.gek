begin function {}

	; Returns all journal entries as a positional array of decoded stringmaps.
	; Each element has fields "id", "flags", "datetime", "location", and "text".
	; Returns an empty array if no entries are stored.
	; Caller is responsible for Ar_Null on the returned array.

	; UDFs

	ref GetRandomIdUDF = CompileScript "PipLog\Utility\GetRandomId.gek"
	ref DecodeJournalEntryFromStringUDF = CompileScript "PipLog\Journal\DecodeJournalEntryFromString.gek"

	; State

	array_var aEncodedEntries = Player.AuxiliaryVariableGetAsArray "PLC_aPlayerJournal"
	array_var aJournalEntries = Ar_Construct "array"

	; Main

	if eval (Ar_Size aEncodedEntries) == -1
		SetFunctionValue aJournalEntries
		let aEncodedEntries := Ar_Null
		return
	endif

	foreach (array_var aElement) <- aEncodedEntries
		string_var sEncodedEntry = aElement["value"]
		array_var aEntry = (Call DecodeJournalEntryFromStringUDF sEncodedEntry)

		if eval (Ar_Size aEntry) != -1
			Ar_Append aJournalEntries, aEntry
		endif

		let aEntry := Ar_Null
	loop

	SetFunctionValue aJournalEntries

	; Clean-Up

	let aEncodedEntries := Ar_Null

end
