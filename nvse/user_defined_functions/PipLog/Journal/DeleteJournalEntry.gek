begin function { short iIndex }

	; Removes the entry at iIndex from persistent storage.
	; Entries above iIndex are shifted down automatically by Ar_Erase.

	; State

	array_var aEncodedEntries = Player.AuxiliaryVariableGetAsArray "PLC_aPlayerJournal"
	short iCount = Ar_Size aEncodedEntries

	; Main

	if eval iCount == -1 || iIndex < 0 || iIndex >= iCount
		let aEncodedEntries := Ar_Null
		return
	endif

	Ar_Erase aEncodedEntries, iIndex

	Player.AuxiliaryVariableSetFromArray "PLC_aPlayerJournal" aEncodedEntries

	; Clean-Up

	let aEncodedEntries := Ar_Null

end
