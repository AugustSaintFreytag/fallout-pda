begin function { array_var aStats }

	; Compacts a stat StringMap into "code:count,code:count" daily stat storage.
	; Caller is responsible for Sv_Destruct on the returned string.

	; UDFs

	ref EncodePlayerStatValuesUDF = CompileScript "PipLog\Stats\EncodePlayerStatValues.gek"

	; Main

	string_var sEncodedStats = (Call EncodePlayerStatValuesUDF aStats)

	SetFunctionValue sEncodedStats

end
