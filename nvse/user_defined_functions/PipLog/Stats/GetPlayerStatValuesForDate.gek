begin function { array_var aDate }

	; Returns a StringMap { statCodeStr: count } for the given date.
	; Returns an empty StringMap if no stats have been recorded for that day.
	; aDate is [year, 0-indexed month, day].
	; Caller is responsible for Ar_Null on the returned array.

	; UDFs

	ref DecodePlayerStatValuesUDF = CompileScript "PipLog\Stats\DecodePlayerStatValues.gek"
	ref GetStorageDateStringUDF = CompileScript "PipLog\DateTime\GetStorageDateString.gek"

	; State

	string_var sDate = (Call GetStorageDateStringUDF aDate)
	array_var aAllStats = Player.AuxStringMapArrayGetAsArray "PLC_aPlayerStats"
	array_var aResult = Ar_Construct "stringmap"
	string_var sEncodedStats = ""

	; Main

	if eval ((Ar_Size aAllStats) != -1) && (Ar_HasKey aAllStats, sDate)
		let sEncodedStats := aAllStats[sDate]
		let aResult := Ar_Null
		let aResult := (Call DecodePlayerStatValuesUDF sEncodedStats)
	endif

	SetFunctionValue aResult

	; Clean-Up

	Sv_Destruct sDate, sEncodedStats
	let aAllStats := Ar_Null

end
