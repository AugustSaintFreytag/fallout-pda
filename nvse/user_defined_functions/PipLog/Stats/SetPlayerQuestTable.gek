begin function { array_var aQuestTable }

	; Encodes and writes decoded player quest stat storage.
	; Returns the number of dates written.

	; UDFs

	ref EncodePlayerQuestIdsUDF = CompileScript "PipLog\Stats\EncodePlayerQuestIds.gek"

	; State

	array_var aStoredQuestStats = Ar_Construct "stringmap"
	short iWrittenDates = 0

	; Main

	if eval (Ar_Size aQuestTable) != -1
		foreach array_var aElement <- aQuestTable
			string_var sDate = aElement["key"]
			array_var aQuestIds = aElement["value"]

			if eval ((Sv_Length sDate) > 0) && ((Ar_Size aQuestIds) != -1)
				string_var sEncodedQuestIds = (Call EncodePlayerQuestIdsUDF aQuestIds)

				if eval (Sv_Length sEncodedQuestIds) > 0
					let aStoredQuestStats[sDate] := sEncodedQuestIds
					let iWrittenDates += 1
				endif

				Sv_Destruct sEncodedQuestIds
			endif

			Sv_Destruct sDate
			let aQuestIds := Ar_Null
		loop
	endif

	Player.AuxStringMapArraySetFromArray "PLC_aPlayerQuestStats" aStoredQuestStats
	SetFunctionValue iWrittenDates

	; Clean-Up

	let aStoredQuestStats := Ar_Null

end
