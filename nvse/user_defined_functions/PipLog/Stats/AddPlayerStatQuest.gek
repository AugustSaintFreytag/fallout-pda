begin function { ref rQuest }

	; Appends a completed quest's editor ID to today's quest log.
	; Stores all days in a single PLC_aPlayerQuestStats StringMap.
	; Date keys map to comma-separated editor ID strings, e.g. "VMS01,FFGoodsprings".
	; Deduplicates — the same quest will not be recorded twice on the same day.

	if eval !(IsFormValid rQuest)
		return
	endif

	; UDFs

	ref GetStorageDateStringUDF = CompileScript "PipLog\DateTime\GetStorageDateString.gek"

	; State

	short iYear = GameYear
	short iMonth = GameMonth - 1
	short iDay = GameDay

	string_var sDate = (Call GetStorageDateStringUDF iYear iMonth iDay)
	string_var sQuestId = GetEditorId rQuest
	array_var aQuestStats = Player.AuxStringMapArrayGetAsArray "PLC_aPlayerQuestStats"

	; Main

	if eval (Ar_Size aQuestStats) == -1
		let aQuestStats := Ar_Construct "stringmap"
	endif

	if eval (Ar_HasKey aQuestStats, sDate)
		string_var sExisting = aQuestStats[sDate]
		array_var aParts = Sv_Split "," sExisting

		short bAlreadyRecorded = eval (Ar_Find sQuestId, aParts) != Ar_BadNumericIndex

		if eval !bAlreadyRecorded
			let aQuestStats[sDate] := Sv_Construct "%z,%z" sExisting sQuestId
			Player.AuxStringMapArraySetFromArray "PLC_aPlayerQuestStats" aQuestStats
		endif

		Sv_Destruct sExisting
		let aParts := Ar_Null
	else
		let aQuestStats[sDate] := sQuestId
		Player.AuxStringMapArraySetFromArray "PLC_aPlayerQuestStats" aQuestStats
	endif

	; Clean-Up

	Sv_Destruct sDate, sQuestId
	let aQuestStats := Ar_Null

end
