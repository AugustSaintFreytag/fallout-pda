begin function { ref rQuest }

	; Appends a completed quest's editor ID to today's quest log.
	; Stores all days in a single PLC_aPlayerQuestStats StringMap.
	; Date keys map to comma-separated editor ID strings, e.g. "VMS01,FFGoodsprings".
	; Deduplicates — the same quest will not be recorded twice on the same day.

	if eval !(IsFormValid rQuest)
		return
	endif

	; UDFs

	ref GetPlayerQuestIdsForDateUDF = CompileScript "PipLog\Stats\GetPlayerQuestIdsForDate.gek"
	ref SetPlayerQuestIdsForDateUDF = CompileScript "PipLog\Stats\SetPlayerQuestIdsForDate.gek"

	; State

	array_var aDate = Ar_List GameYear, (GameMonth - 1), GameDay
	string_var sQuestId = GetEditorId rQuest
	array_var aQuestIds = (Call GetPlayerQuestIdsForDateUDF aDate)

	; Main

	if eval (Ar_Find sQuestId, aQuestIds) == Ar_BadNumericIndex
		Ar_Append aQuestIds, sQuestId
		Call SetPlayerQuestIdsForDateUDF aDate aQuestIds
	endif

	; Clean-Up

	Sv_Destruct sQuestId
	let aDate := Ar_Null
	let aQuestIds := Ar_Null

end
