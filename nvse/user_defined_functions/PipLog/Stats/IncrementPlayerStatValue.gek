begin function { short iStatCode, short iUpdatedValue }

	; Increments a daily gameplay stat by the given delta.
	; Stats are stored per-day in PLC_aPlayerStats, encoded as "code:count,code:count,...".

	; UDFs

	ref GetPlayerStatValuesUDF = CompileScript "PipLog\Stats\GetPlayerStatValues.gek"
	ref GetStorageDateStringUDF = CompileScript "PipLog\DateTime\GetStorageDateString.gek"

	; State

	string_var sStatCode = $iStatCode

	short iYear = GameYear
	short iMonth = GameMonth - 1
	short iDay = GameDay

	array_var aStats = (Call GetPlayerStatValuesUDF iDay iMonth iYear)

	; Main

	if eval (Ar_HasKey aStats, sStatCode)
		short iPreviousValue = aStats[sStatCode]
		let aStats[sStatCode] := (iPreviousValue + iUpdatedValue)
	else
		let aStats[sStatCode] := iUpdatedValue
	endif

	; Re-encode to CSV string

	string_var sEncoded = ""

	foreach (array_var aElement) <- aStats
		string_var sCode = aElement["key"]
		short iValue = aElement["value"]

		if eval sEncoded != ""
			let sEncoded += ","
		endif
		
		let sEncoded += (sCode + ":" + $iValue)
		Sv_Destruct sCode
	loop

	; Write back

	string_var sDate = Call GetStorageDateStringUDF iYear iMonth iDay
	array_var aAllStats = Player.AuxStringMapArrayGetAsArray "PLC_aPlayerStats"

	if eval (Ar_Size aAllStats) == -1
		let aAllStats := Ar_Construct "stringmap"
	endif

	let aAllStats[sDate] := sEncoded
	Player.AuxStringMapArraySetFromArray "PLC_aPlayerStats" aAllStats

	; Clean-Up

	Sv_Destruct sStatCode, sEncoded, sDate

	let aStats := Ar_Null
	let aAllStats := Ar_Null

end