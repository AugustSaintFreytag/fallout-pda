begin function { short iStatCode, short iUpdatedValue }

	; Increments a daily gameplay stat by the given delta.
	; Stats are stored per-day in PLC_aPlayerStats, encoded as "code:count,code:count,...".

	; UDFs

	ref GetPlayerStatValuesForDateUDF = CompileScript "PipLog\Stats\GetPlayerStatValuesForDate.gek"
	ref SetPlayerStatValuesForDateUDF = CompileScript "PipLog\Stats\SetPlayerStatValuesForDate.gek"

	; State

	string_var sStatCode = $iStatCode

	array_var aDate = Ar_List GameYear, GameMonth, GameDay
	array_var aStats = (Call GetPlayerStatValuesForDateUDF aDate)

	; Main

	if eval (Ar_HasKey aStats, sStatCode)
		short iPreviousValue = aStats[sStatCode]
		let aStats[sStatCode] := (iPreviousValue + iUpdatedValue)
		; PrintC "Incrementing existing player stat value, code %g, value %g -> %g." iStatCode iPreviousValue (aStats[sStatCode])
	else
		let aStats[sStatCode] := iUpdatedValue
		; PrintC "Writing new player stat value for date, code %g, value %g -> %g." iStatCode 0 (aStats[sStatCode])
	endif

	Call SetPlayerStatValuesForDateUDF aDate aStats

	Player.AuxiliaryVariableSetFloat "*PLC_bIsCalendarSummaryModified" 1

	; Clean-Up

	Sv_Destruct sStatCode
	let aDate := Ar_Null
	let aStats := Ar_Null

end
