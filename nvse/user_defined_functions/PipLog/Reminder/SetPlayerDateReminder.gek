begin function { array_var aDate, short iState }

	; Sets or clears the player's one-shot reminder for aDate.
	; aDate is [year, 0-indexed month, day].
	; iState: 1 = set, 0 = clear.

	; UDFs

	ref GetStorageDateStringUDF = CompileScript "PipLog\DateTime\GetStorageDateString.gek"

	; State

	array_var aPlayerReminders = Player.AuxStringMapArrayGetAsArray "PLC_aPlayerReminders"
	string_var sDate = (Call GetStorageDateStringUDF aDate)

	if eval (Ar_Size aPlayerReminders) == -1
		let aPlayerReminders := Ar_Construct "stringmap"
	endif

	; Main

	if iState
		let aPlayerReminders[sDate] := "1"
	else
		if eval (Ar_HasKey aPlayerReminders, sDate)
			Ar_Erase aPlayerReminders, sDate
		endif
	endif

	if eval (Ar_Size aPlayerReminders) > 0
		Player.AuxStringMapArraySetFromArray "PLC_aPlayerReminders" aPlayerReminders
	else
		Player.AuxiliaryVariableErase "PLC_aPlayerReminders"
	endif

	; Clean-Up

	Sv_Destruct sDate
	let aPlayerReminders := Ar_Null

end
