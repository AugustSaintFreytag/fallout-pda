begin function { array_var aParams }

	; UDFs

	ref AddPlayerEventUDF = CompileScript "PipLog\Event\AddPlayerEvent.gek"
	ref ParseStorageDateToComponentsUDF = CompileScript "PipLog\DateTime\ParseStorageDateToComponents.gek"
	ref GetStorageDateStringUDF = CompileScript "PipLog\DateTime\GetStorageDateString.gek"
	ref CreateEventUDF = CompileScript "PipLog\Event\CreateEvent.gek"
	ref AddEventUDF = CompileScript "PipLog\Event\AddEvent.gek"

	; Main

	if eval (aParams == Ar_Null) || !(Ar_HasKey aParams "date") || !(Ar_HasKey aParams "name")
		PrintC "Cannot add player event via API call, missing or invalid params."
		return
	endif

	array_var aEventDate = (Call ParseStorageDateToComponentsUDF (aParams["date"]))

	if eval aEventDate == Ar_Null
		PrintC "Cannot add player event via API call, invalid date from input '%z'." (aParams["date"])
		return
	endif

	string_var sEventDate = (Call GetStorageDateStringUDF aEventDate)
	array_var aEventParams = Ar_DeepCopy aParams

	let aEventParams["date"] := sEventDate

	PrintC "Adding player event '%z' for validated date %z via API call." (aEventParams["name"]) (aEventParams["date"])

	array_var aEvent = Call CreateEventUDF aEventParams
	Call AddEventUDF aEvent 1

	; Invalidate

	Player.AuxiliaryVariableSetFloat "*PLC_bIsEventListModified" 1
	Player.AuxiliaryVariableSetFloat "*PLC_bIsCalendarViewModified" 1
	Player.AuxiliaryVariableSetFloat "*PLC_bIsCalendarSelectionModified" 1
	
	; Clean-Up

	Sv_Destruct sEventDate

	let aEventDate := Ar_Null
	let aEventParams := Ar_Null
	let aEvent := Ar_Null

end