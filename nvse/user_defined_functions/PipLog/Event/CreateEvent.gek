begin function { array_var aParams }

	; UDFs

	ref GetRandomIdUDF = CompileScript "PipLog\Utils\GetRandomId.gek"
	ref EncodeEventFlagsUDF = CompileScript "PipLog\Event\EncodeEventFlags.gek"

	; Main

	array_var aEvent = Ar_Construct "stringmap"

	; Value Properties

	let aEvent["id"] := (Call GetRandomIdUDF)
	let aEvent["date"] := aParams["date"]
	let aEvent["name"] := aParams["name"]

	if eval (Ar_HasKey aParams "description")
		let aEvent["description"] := aParams["description"]
	else 
		let aEvent["description"] := ""
	endif

	if eval (Ar_HasKey aParams "reference")
		let aEvent["reference"] := aParams["reference"]
	else
		let aEvent["reference"] := ""
	endif

	; Derived Properties

	let aEvent["_isSystemEvent"] := 0
	let aEvent["_isPlayerEvent"] := 0

	; Encode & Return

	Call EncodeEventFlagsUDF aEvent

	SetFunctionValue aEvent

	; Clean-Up

	let aEvent := Ar_Null

end
