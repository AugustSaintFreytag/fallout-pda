begin function { string_var sIdList, string_var sId }

	; Removes sId from the comma-separated event ID list string.
	; Returns the list unchanged if sId is not present or if sIdList is empty.
	; Returns an empty string if the list becomes empty after removal.
	; Caller is responsible for Sv_Destruct on the returned string.

	; UDFs

	ref DecodeEventIdsFromStringUDF = CompileScript "PipLog\Event\DecodeEventIdsFromString.gek"

	; Main

	if eval sIdList == ""
		SetFunctionValue sIdList
		return
	endif

	array_var aIds = (Call DecodeEventIdsFromStringUDF sIdList)
	short iIndex = (Ar_Find sId, aIds)

	if eval iIndex == Ar_BadNumericIndex
		SetFunctionValue sIdList
		let aIds := Ar_Null
		return
	endif

	Ar_Erase aIds, iIndex

	string_var sNewIdList = (Sv_Join aIds, ",")

	SetFunctionValue sNewIdList

	; Clean-Up

	let aIds := Ar_Null

end
