begin function { short iDay, short iMonth, short iYear, string_var sEventName, short iIntervalKind }

	; Adds a player-defined custom event to the persistent event registry.
	; iMonth is 0-indexed.
	; Interval kind: 0 = date-specific/non-recurring, 1 = yearly, 2 = monthly, 3 = weekly, 4 = daily.
	; Supported storage patterns: date-specific = YYYY-MM-DD, yearly = *-MM-DD, monthly = *-*-DD.
	; Events are stored as player events (bIsPlayerEvent = 1).

	if eval (iIntervalKind == 3) || (iIntervalKind == 4)
		return
	endif

	if eval (iIntervalKind < 0) || (iIntervalKind > 4)
		return
	endif

	; UDFs

	ref GetStorageDateStringUDF = CompileScript "PipLog\DateTime\GetStorageDateString.gek"
	ref GetRecurringDatePatternStringUDF = CompileScript "PipLog\DateTime\GetRecurringDatePatternString.gek"
	ref CreateEventUDF = CompileScript "PipLog\Event\CreateEvent.gek"
	ref AddEventUDF = CompileScript "PipLog\Event\AddEvent.gek"

	; State

	string_var sDate = ""

	if iIntervalKind == 0
		let sDate := (Call GetStorageDateStringUDF iYear iMonth iDay)
	else
		let sDate := (Call GetRecurringDatePatternStringUDF iIntervalKind iMonth iDay)
	endif

	; Main

	array_var aEvent = (Call CreateEventUDF sDate sEventName)
	Call AddEventUDF aEvent 1

	; Clean-Up

	Sv_Destruct sDate
	let aEvent := Ar_Null

end
