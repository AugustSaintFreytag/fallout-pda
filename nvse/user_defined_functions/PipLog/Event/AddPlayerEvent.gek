begin function { short iDay, short iMonth, short iYear, string_var sEventName, short iFrequency }

	; Adds a player-defined custom event to the persistent event registry.
	; iMonth is 0-indexed.
	; iFrequency values:
	;   1 = one-time      (YYYY-MM-DD)
	;   2 = weekly        (unsupported — returns early)
	;   3 = monthly       (*-*-DD)
	;   4 = yearly        (*-MM-DD)
	; Events are stored as player events (bIsPlayerEvent = 1).

	if iFrequency == 2
		return
	endif

	if eval (iFrequency < 1) || (iFrequency > 4)
		return
	endif

	; UDFs

	ref GetStorageDateStringUDF = CompileScript "PipLog\DateTime\GetStorageDateString.gek"
	ref GetRecurringDateStringUDF = CompileScript "PipLog\DateTime\GetRecurringDateString.gek"
	ref GetMonthlyDateStringUDF = CompileScript "PipLog\DateTime\GetMonthlyDateString.gek"
	ref CreateEventUDF = CompileScript "PipLog\Event\CreateEvent.gek"
	ref AddEventUDF = CompileScript "PipLog\Event\AddEvent.gek"

	; State

	string_var sDate = ""

	if iFrequency == 1
		let sDate := (Call GetStorageDateStringUDF iYear iMonth iDay)
	elseif iFrequency == 3
		let sDate := (Call GetMonthlyDateStringUDF iDay)
	elseif iFrequency == 4
		let sDate := (Call GetRecurringDateStringUDF iMonth iDay)
	endif

	; Main

	array_var aEvent = (Call CreateEventUDF sDate sEventName)
	Call AddEventUDF aEvent 1

	; Clean-Up

	Sv_Destruct sDate
	let aEvent := Ar_Null

end
