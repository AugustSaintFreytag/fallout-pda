begin function { array_var aDate, string_var sName, short iIntervalKind }

	; Adds a player-defined custom event to the persistent event registry.
	; aDate is [year, 0-indexed month, day].
	; Interval kind: 0 = date-specific/non-recurring, 1 = yearly, 2 = monthly, 3 = daily.
	; Supported storage patterns: date-specific = YYYY-MM-DD, yearly = *-MM-DD, monthly = *-*-DD, daily = *-*-*.
	; Events are stored as player events (bIsPlayerEvent = 1).

	if eval (iIntervalKind < 0) || (iIntervalKind > 3)
		return
	endif

	; UDFs

	ref GetStorageDateStringUDF = CompileScript "PipLog\DateTime\GetStorageDateString.gek"
	ref GetRecurringDatePatternStringUDF = CompileScript "PipLog\DateTime\GetRecurringDatePatternString.gek"
	ref CreateEventUDF = CompileScript "PipLog\Event\CreateEvent.gek"
	ref AddEventUDF = CompileScript "PipLog\Event\AddEvent.gek"

	; State

	short iMonth = aDate[1]
	short iDay = aDate[2]
	
	string_var sDate = ""

	if iIntervalKind == 0
		let sDate := Call GetStorageDateStringUDF aDate
	else
		let sDate := Call GetRecurringDatePatternStringUDF iIntervalKind iMonth iDay
	endif

	; Main

	array_var aEventParams = Ar_Map "date"::sDate, "name"::sName
	array_var aEvent = Call CreateEventUDF aEventParams

	Call AddEventUDF aEvent 1

	; Clean-Up

	Sv_Destruct sDate
	let aEvent := Ar_Null
	let aEventParams := Ar_Null

end
