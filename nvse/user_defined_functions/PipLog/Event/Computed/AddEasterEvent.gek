begin function { short iYear, string_var sDescription }

	; Replaces and adds the computed Easter event for iYear.

	; UDFs

	ref GetEasterDateUDF = CompileScript "PipLog\Calendar\GetEasterDate.gek"
	ref CreateEventUDF = CompileScript "PipLog\Event\CreateEvent.gek"
	ref AddEventUDF = CompileScript "PipLog\Event\AddEvent.gek"
	ref RemoveEventByReferenceUDF = CompileScript "PipLog\Event\RemoveEventByReference.gek"

	; Config

	short bShouldGenerateEaster = GetINIFloat "Events:bEaster" "PipLog\PipLog.ini"

	; Main

	Call RemoveEventByReferenceUDF "easter"

	if eval !bShouldGenerateEaster
		return
	endif

	string_var sEasterDate = (Call GetEasterDateUDF iYear)

	if eval sEasterDate != ""
		array_var aEasterEventParams = Ar_Map "reference"::"easter", "date"::sEasterDate, "name"::"Easter", "description"::sDescription
		array_var aEasterEvent = Call CreateEventUDF aEasterEventParams
		
		Call AddEventUDF aEasterEvent 0

		let aEasterEvent := Ar_Null
		let aEasterEventParams := Ar_Null
	endif

	; Clean-Up

	Sv_Destruct sEasterDate

end
