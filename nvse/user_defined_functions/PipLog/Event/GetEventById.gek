begin function { string_var sEventId }

	; Returns the decoded event with sEventId from global or player event storage.
	; Checks global storage first, then player storage.
	; Returns Ar_Null if the event does not exist.

	; UDFs

	ref DecodeEventFromStringUDF = CompileScript "PipLog\Event\DecodeEventFromString.gek"
	ref EncodeEventFlagsUDF = CompileScript "PipLog\Event\EncodeEventFlags.gek"

	; State

	string_var sEncodedEvent = ""
	short bDidFindEvent = 0

	; Check Global Events

	array_var aEventsById = Player.AuxStringMapArrayGetAsArray "*PLC_aGlobalEventsById"

	if eval (Ar_Size aEventsById) != -1
		if eval (Ar_HasKey aEventsById, sEventId)
			let sEncodedEvent := aEventsById[sEventId]
			let bDidFindEvent := 1
		endif
	endif

	; Check Player Events

	if eval !bDidFindEvent
		let aEventsById := Ar_Null
		let aEventsById := Player.AuxStringMapArrayGetAsArray "PLC_aPlayerEventsById"

		if eval (Ar_Size aEventsById) != -1
			if eval (Ar_HasKey aEventsById, sEventId)
				let sEncodedEvent := aEventsById[sEventId]
				let bDidFindEvent := 1
			endif
		endif
	endif

	; Verify Match

	if eval !bDidFindEvent
		SetFunctionValue Ar_Null

		Sv_Destruct sEncodedEvent
		let aEventsById := Ar_Null
		return
	endif

	; Return

	array_var aEvent = (Call DecodeEventFromStringUDF sEncodedEvent)

	SetFunctionValue aEvent

	; Clean-Up

	Sv_Destruct sEncodedEvent
	let aEventsById := Ar_Null

end
