begin function {}

	; Registers each system event into global event storage.
	; aSystemEvents should be a positional array of event stringmaps as returned by GetSystemEvents.

	; UDFs

	ref GetSystemEventsUDF = CompileScript "PipLog\Event\GetSystemEvents.gek"
	ref AddEventUDF = CompileScript "PipLog\Event\AddEvent.gek"

	; Main

	array_var aSystemEvents = (Call GetSystemEventsUDF)

	PrintC "Adding %g system events to calendar." (Ar_Size aSystemEvents)

	foreach array_var aElement <- aSystemEvents
		Call AddEventUDF (*aElement) 0
	loop

	; Clean-Up

	let aSystemEvents := Ar_Null

end
