begin function { array_var aEvent }

	; Takes a stringmap with fields "id", "date", "name".
	; Returns the event encoded as a "@@@"-delimited string.
	; Caller is responsible for Sv_Destruct on the returned string.

	; Main

	if eval (aEvent == Ar_Null) || (Ar_Size aEvent) == -1
		PrintC "Cannot encode event to string, event is null."
		return
	endif

	array_var aComponents = Ar_List aEvent["id"], aEvent["date"], aEvent["name"]
	string_var sEncodedEvent = Sv_Join aComponents, "@@@"

	SetFunctionValue sEncodedEvent

	; Clean-Up

	let aComponents := Ar_Null

end
