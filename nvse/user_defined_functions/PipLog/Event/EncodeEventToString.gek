begin function { array_var aEvent }

	; Returns the event encoded as a "@@@"-delimited string.
	; Caller is responsible for Sv_Destruct on the returned string.

	; UDFs

	ref EncodeEventFlagsUDF = CompileScript "PipLog\Event\EncodeEventFlags.gek"

	; Main

	if eval (aEvent == Ar_Null) || (Ar_Size aEvent) == -1
		PrintC "Cannot encode event to string, event is null or malformed."
		return
	endif

	Call EncodeEventFlagsUDF aEvent

	short iFlags = aEvent["flags"]
	string_var sFlags = $iFlags
	string_var sDescription = ""
	string_var sEncodedDescription = ""
	string_var sReference = ""

	if eval (Ar_HasKey aEvent, "description")
		let sDescription := aEvent["description"]
	endif

	if eval (Ar_HasKey aEvent, "reference")
		let sReference := aEvent["reference"]
	endif

	if eval (Sv_Length sDescription) > 0
		let sEncodedDescription := Sv_Construct "%z" sDescription
	elseif eval (Sv_Length sReference) > 0
		let sEncodedDescription := " "
	endif

	array_var aComponents = Ar_List aEvent["id"], aEvent["date"], aEvent["name"], sFlags

	if eval ((Sv_Length sEncodedDescription) > 0) || ((Sv_Length sReference) > 0)
		Ar_Append aComponents, sEncodedDescription
	endif

	if eval (Sv_Length sReference) > 0
		Ar_Append aComponents, sReference
	endif

	string_var sEncodedEvent = Sv_Join aComponents, "@@@"

	SetFunctionValue sEncodedEvent

	; Clean-Up

	Sv_Destruct sFlags, sDescription, sEncodedDescription, sReference
	let aComponents := Ar_Null

end
