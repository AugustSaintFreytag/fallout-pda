begin function { string_var sData }

	; Splits a "@@@"-delimited string and reconstructs an event stringmap.
	; Returns Ar_Null if the encoded string is malformed (wrong field count).

	; UDFs

	ref DecodeEventFlagsUDF = CompileScript "PipLog\Event\DecodeEventFlags.gek"

	; Main

	array_var aComponents = Sv_Split sData, "@@@"
	short iNumComponents = Ar_Size aComponents

	if eval (iNumComponents != 3) && (iNumComponents != 4) && (iNumComponents != 5) && (iNumComponents != 6)
		PrintC "Could not decode event from string '%z', invalid format." sData

		SetFunctionValue Ar_Null
		let aComponents := Ar_Null
		return
	endif

	array_var aEvent = Ar_Construct "stringmap"

	let aEvent["id"] := aComponents[0]
	let aEvent["date"] := aComponents[1]
	let aEvent["name"] := aComponents[2]
	let aEvent["description"] := ""
	let aEvent["reference"] := ""

	short iFlags = 0

	if iNumComponents == 4
		let iFlags := #(aComponents[3])
	elseif iNumComponents == 5
		let iFlags := #(aComponents[3])
		let aEvent["description"] := aComponents[4]
	elseif iNumComponents == 6
		let iFlags := #(aComponents[3])
		let aEvent["description"] := aComponents[4]
		let aEvent["reference"] := aComponents[5]

		if eval aEvent["description"] == " "
			let aEvent["description"] := ""
		endif
	endif

	let aEvent["flags"] := iFlags
	Call DecodeEventFlagsUDF aEvent

	SetFunctionValue aEvent

	; Clean-Up

	let aComponents := Ar_Null

end
