begin function { array_var aDate }

	; Returns a positional array of decoded event stringmaps for the given date.
	; Checks both global (transient) and player (persistent) event storage.
	; Date patterns checked: YYYY-MM-DD, *-MM-DD, *-*-DD, *-*-*.
	; aDate is [year, 0-indexed month, day].
	; Caller is responsible for Ar_Null on the returned array.

	; UDFs

	ref GetStorageDateStringUDF = CompileScript "PipLog\DateTime\GetStorageDateString.gek"
	ref GetRecurringDatePatternStringUDF = CompileScript "PipLog\DateTime\GetRecurringDatePatternString.gek"
	ref GetEventsForDatePatternUDF = CompileScript "PipLog\Event\GetEventsForDatePattern.gek"

	; State

	short iMonth = aDate[1]
	short iDay = aDate[2]

	string_var sDateSpecific = (Call GetStorageDateStringUDF aDate)
	string_var sDateYearly = (Call GetRecurringDatePatternStringUDF 1 iMonth iDay)
	string_var sDateMonthly = (Call GetRecurringDatePatternStringUDF 2 iMonth iDay)
	string_var sDateDaily = (Call GetRecurringDatePatternStringUDF 3 iMonth iDay)

	array_var aGlobalEventsById = Player.AuxStringMapArrayGetAsArray "*PLC_aGlobalEventsById"
	array_var aGlobalEventsByDate = Player.AuxStringMapArrayGetAsArray "*PLC_aGlobalEventsByDate"
	array_var aPlayerEventsById = Player.AuxStringMapArrayGetAsArray "PLC_aPlayerEventsById"
	array_var aPlayerEventsByDate = Player.AuxStringMapArrayGetAsArray "PLC_aPlayerEventsByDate"

	; Main
	
	array_var aAllEvents = Ar_Construct "array"
	array_var aPatterns = Ar_List sDateSpecific, sDateYearly, sDateMonthly, sDateDaily

	foreach (array_var aEntry) <- aPatterns
		string_var sPattern = aEntry["value"]
		Call GetEventsForDatePatternUDF sPattern aGlobalEventsById aGlobalEventsByDate aAllEvents
		Call GetEventsForDatePatternUDF sPattern aPlayerEventsById aPlayerEventsByDate aAllEvents
	loop

	SetFunctionValue aAllEvents

	; Clean-Up

	Sv_Destruct sDateSpecific, sDateYearly, sDateMonthly, sDateDaily

	let aPatterns := Ar_Null
	let aGlobalEventsById := Ar_Null
	let aGlobalEventsByDate := Ar_Null
	let aPlayerEventsById := Ar_Null
	let aPlayerEventsByDate := Ar_Null

end
