begin function { string_var sInput }

	; Callback for the birthday text input prompt.
	; Parses a DD.MM.YYYY string, validates, clamps day to a valid range,
	; and saves the birthday as one persistent storage date string.

	; UDFs

	ref ParseDisplayDateToComponentsUDF = CompileScript "PipLog\DateTime\ParseDisplayDateToComponents.gek"
	ref GetDaysInMonthUDF = CompileScript "PipLog\DateTime\GetDaysInMonth.gek"
	ref GetStorageDateStringUDF = CompileScript "PipLog\DateTime\GetStorageDateString.gek"
	ref GetEventDescriptionsByReferenceUDF = CompileScript "PipLog\Event\GetEventDescriptionsByReference.gek"
	ref AddBirthdayEventUDF = CompileScript "PipLog\Event\Computed\AddBirthdayEvent.gek"

	; Main

	array_var aBirthdayDate = (Call ParseDisplayDateToComponentsUDF sInput)

	if eval aBirthdayDate == Ar_Null
		return
	endif

	short iYear = aBirthdayDate[0]
	short iMonth = aBirthdayDate[1]
	short iDay = aBirthdayDate[2]

	if eval (iDay < 1) || (iMonth < 0) || (iMonth > 11) || (iYear < 1) || (iYear > GameYear)
		let aBirthdayDate := Ar_Null
		Print "Could not set birthday from player input, invalid format or future date."
		return
	endif

	short iDaysInMonth = (Call GetDaysInMonthUDF iYear iMonth)

	if iDay > iDaysInMonth
		let iDay := iDaysInMonth
		let aBirthdayDate[2] := iDay
	endif

	string_var sBirthdayDate = (Call GetStorageDateStringUDF aBirthdayDate)

	Player.AuxiliaryVariableSetString "PLC_sBirthdayDate" ($sBirthdayDate)

	array_var aDescriptionsByReference = (Call GetEventDescriptionsByReferenceUDF)
	Call AddBirthdayEventUDF aDescriptionsByReference

	Player.AuxiliaryVariableSetFloat "*PLC_bIsCalendarViewModified" 1
	Player.AuxiliaryVariableSetFloat "*PLC_bIsCalendarSummaryModified" 1
	Player.AuxiliaryVariableSetFloat "*PLC_bIsCalendarSelectionModified" 1
	Player.AuxiliaryVariableSetFloat "*PLC_bIsEventListModified" 1
	Player.AuxiliaryVariableSetFloat "*PLC_bIsEventSelectionModified" 1

	; Clean-Up

	Sv_Destruct sBirthdayDate
	let aDescriptionsByReference := Ar_Null
	let aBirthdayDate := Ar_Null

end
