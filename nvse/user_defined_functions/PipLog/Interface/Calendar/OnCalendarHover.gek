begin function { short iMenuId }

	; Updates the calendar hover date in the view model.
	; The UI control loop owns writing summary text and scrollbar state.

	; Main

	string_var sComponent = GetActiveUIComponentFullName ; Component name is also encoded date string.
	string_var sCurrentHover = Player.AuxiliaryVariableGetString "*PLC_sHoveredCalendarDate"

	if eval (Sv_Count "MapMenu/CM_MainRect/CM_CalendarRect/CM_CalendarGrids/", sComponent) == 0
		if eval (Sv_Length sCurrentHover) > 0
			Player.AuxiliaryVariableErase "*PLC_sHoveredCalendarDate"
			Player.AuxiliaryVariableSetFloat "*PLC_bIsCalendarSummaryModified" 1
		endif

		Sv_Destruct sComponent, sCurrentHover
		return
	endif

	Sv_Replace "MapMenu/CM_MainRect/CM_CalendarRect/CM_CalendarGrids/|", sComponent
	Sv_Replace "/CM_Box_Main|", sComponent

	if eval (sComponent != sCurrentHover)
		Player.AuxiliaryVariableSetString "*PLC_sHoveredCalendarDate" ($sComponent)
		Player.AuxiliaryVariableSetFloat "*PLC_bIsCalendarSummaryModified" 1
	endif

	; Clean-Up

	Sv_Destruct sComponent, sCurrentHover

end
