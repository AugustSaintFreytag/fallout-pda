begin function {}

	; Unloads any existing calendar tile grid and generates a fresh 6x7 grid for the
	; view month. Tiles span prev/current/next month overlap. Sets tile positions,
	; day labels, alpha, and day-state for the current month. Writes *PLC_bDidGenerateCalendar
	; to 1 on completion. Reads *PLC_iCalendarYear/*PLC_iCalendarMonth; defaults to the current
	; in-game month if year is 0 (unset), and persists the defaults back to aux vars.

	; UDFs

	ref GetStorageDateStringUDF = CompileScript "PipLog\DateTime\GetStorageDateString.gek"
	ref GetDayOfWeekUDF = CompileScript "PipLog\DateTime\GetDayOfWeek.gek"
	ref GetDaysInMonthUDF = CompileScript "PipLog\DateTime\GetDaysInMonth.gek"

	; State

	short iCalendarYear = Player.AuxiliaryVariableGetFloat "*PLC_iCalendarYear"
	short iCalendarMonth = Player.AuxiliaryVariableGetFloat "*PLC_iCalendarMonth"

	; Main

	UnloadUIComponent "MapMenu/CM_MainRect/CM_CalendarRect/CM_CalendarGrids"
	AddTileFromTemplate "MapMenu/CM_MainRect/CM_CalendarRect|CM_GridParent_Template|CM_CalendarGrids"

	if iCalendarYear == 0
		let iCalendarYear := GameYear
		let iCalendarMonth := GameMonth

		Player.AuxiliaryVariableSetFloat "*PLC_iCalendarYear" iCalendarYear
		Player.AuxiliaryVariableSetFloat "*PLC_iCalendarMonth" iCalendarMonth
	endif

	; Adjacent months

	short iPreviousMonth = iCalendarMonth - 1
	short iPreviousYear = iCalendarYear

	if iPreviousMonth < 0
		let iPreviousMonth := 11
		let iPreviousYear -= 1
	endif

	short iNextMonth = iCalendarMonth + 1
	short iNextYear = iCalendarYear

	if iNextMonth > 11
		let iNextMonth := 0
		let iNextYear += 1
	endif

	short iDaysInCurrentMonth = (Call GetDaysInMonthUDF iCalendarYear iCalendarMonth)
	short iDaysInPreviousMonth = (Call GetDaysInMonthUDF iPreviousYear iPreviousMonth)

	; Month title

	string_var sMonthTitlePath = (Sv_Construct "MapMenu/CM_MainRect/CM_CalendarRect/CM_MonthTitle/_month_%g" iCalendarMonth)
	string_var sMonthName = GetUIString ($sMonthTitlePath)
	string_var sMonthTitle = Sv_Construct "%z %g" sMonthName iCalendarYear

	SetUIStringAlt "MapMenu/CM_MainRect/CM_CalendarRect/CM_MonthTitle/string" ($sMonthTitle)
	Sv_Destruct sMonthTitlePath, sMonthName, sMonthTitle

	; Grid start position

	array_var aFirstDate = Ar_List iCalendarYear, iCalendarMonth, 1
	short iFirstDayOfWeek = (Call GetDayOfWeekUDF aFirstDate)
	short iTileDay = 1
	short iMonthOffset = 0

	if iFirstDayOfWeek > 0
		let iTileDay := iDaysInPreviousMonth - iFirstDayOfWeek + 1
		let iMonthOffset := -1
	endif

	; Today's date for tile highlighting

	short iTodayYear = GameYear
	short iTodayMonth = GameMonth
	short iTodayDay = GameDay

	; Grid layout

	short iTileSize = 52
	short iTilesInCurrentRow = 0
	short iTileRowY = 0
	short iBuiltTileCount = 0

	short iTileMonth = 0
	short iTileYear = 0

	string_var sTileDate = ""
	string_var sTileInsertCommand = ""
	string_var sTileBasePath = ""
	string_var sTilePropertyPath = ""

	while iBuiltTileCount < 42
		if iTilesInCurrentRow == 7
			let iTilesInCurrentRow := 0
			let iTileRowY += iTileSize
		endif

		if iMonthOffset == -1
			let iTileMonth := iPreviousMonth
			let iTileYear := iPreviousYear
		elseif iMonthOffset == 0
			let iTileMonth := iCalendarMonth
			let iTileYear := iCalendarYear
		else
			let iTileMonth := iNextMonth
			let iTileYear := iNextYear
		endif

		array_var aTileDate = Ar_List iTileYear, iTileMonth, iTileDay
		let sTileDate := (Call GetStorageDateStringUDF aTileDate)
		let aTileDate := Ar_Null
		let sTileInsertCommand := (Sv_Construct "MapMenu/CM_MainRect/CM_CalendarRect/CM_CalendarGrids|CM_Box_Template|%z" sTileDate)

		AddTileFromTemplate ($sTileInsertCommand)

		let sTileBasePath := Sv_Construct "MapMenu/CM_MainRect/CM_CalendarRect/CM_CalendarGrids/%z" sTileDate

		let iTilesInCurrentRow += 1

		if iBuiltTileCount == 0
			PrintC "PipLog: first tile name=%z, x_readback=%g" sTileDate (GetUIFloat (Sv_Construct "MapMenu/CM_MainRect/CM_CalendarRect/CM_CalendarGrids/%z/x" sTileDate))
		endif

		let sTilePropertyPath := Sv_Construct "%z/_string1" sTileBasePath
		SetUIStringAlt ($sTilePropertyPath) ($iTileDay)

		let sTilePropertyPath := Sv_Construct "%z/x" sTileBasePath
		SetUIFloatAlt ($sTilePropertyPath) (iTilesInCurrentRow * iTileSize)

		let sTilePropertyPath := Sv_Construct "%z/y" sTileBasePath
		SetUIFloatAlt ($sTilePropertyPath) iTileRowY

		if iMonthOffset == -1
			let sTilePropertyPath := Sv_Construct "%z/_alpha1" sTileBasePath
			SetUIFloatAlt ($sTilePropertyPath) 128
		elseif iMonthOffset == 0
			let sTilePropertyPath := Sv_Construct "%z/_alpha1" sTileBasePath
			SetUIFloatAlt ($sTilePropertyPath) 255

			if eval (iCalendarMonth == iTodayMonth) && (iCalendarYear == iTodayYear)
				if iTileDay == iTodayDay
					let sTilePropertyPath := Sv_Construct "%z/_day_state" sTileBasePath
					SetUIFloatAlt ($sTilePropertyPath) GameHour
					Player.AuxiliaryVariableSetFloat "*PLC_bPulseAscending" 0
				elseif iTileDay < iTodayDay
					let sTilePropertyPath := Sv_Construct "%z/_day_state" sTileBasePath
					SetUIFloatAlt ($sTilePropertyPath) 24
				endif
			endif
		else
			let sTilePropertyPath := Sv_Construct "%z/_alpha1" sTileBasePath
			SetUIFloatAlt ($sTilePropertyPath) 150
		endif

		let iTileDay += 1

		if eval (iMonthOffset == -1) && (iTileDay > iDaysInPreviousMonth)
			let iTileDay := 1
			let iMonthOffset := 0
		endif

		if eval (iMonthOffset == 0) && (iTileDay > iDaysInCurrentMonth)
			let iTileDay := 1
			let iMonthOffset := 1
		endif

		let iBuiltTileCount += 1
	loop

	Player.AuxiliaryVariableSetFloat "*PLC_bDidGenerateCalendar" 1
	Player.AuxiliaryVariableSetFloat "*PLC_bIsCalendarViewModified" 0
	Player.AuxiliaryVariableSetFloat "*PLC_bIsCalendarSelectionModified" 1

	; Clean-Up

	Sv_Destruct sTileDate, sTileInsertCommand, sTileBasePath, sTilePropertyPath
	let aFirstDate := Ar_Null

end
