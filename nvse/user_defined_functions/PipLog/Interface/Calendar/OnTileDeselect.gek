begin function {}

	; Clears the selected calendar date in the view model.
	; The UI control loop owns the visual tile, tools, and summary text updates.

	; UDFs

	ref GetStorageDateStringUDF = CompileScript "PipLog\DateTime\GetStorageDateString.gek"

	; State

	short iSelectedDay = Player.AuxiliaryVariableGetFloat "*PLC_iSelectedDay"
	short iSelectedMonth = Player.AuxiliaryVariableGetFloat "*PLC_iSelectedMonth"
	short iSelectedYear = Player.AuxiliaryVariableGetFloat "*PLC_iSelectedYear"

	; Main

	string_var sSelectedDate = Player.AuxiliaryVariableGetString "*PLC_sSelectedCalendarDate"

	if eval (Sv_Length sSelectedDate) == 0
		if iSelectedDay >= 1
			array_var aSelectedDate = Ar_List iSelectedYear, iSelectedMonth, iSelectedDay
			let sSelectedDate := (Call GetStorageDateStringUDF aSelectedDate)
			let aSelectedDate := Ar_Null
		endif
	endif

	Player.AuxiliaryVariableErase "*PLC_sSelectedCalendarDate"
	
	Player.AuxiliaryVariableSetString "*PLC_sPreviousSelectedCalendarDate" ($sSelectedDate)
	Player.AuxiliaryVariableSetFloat "*PLC_bIsCalendarSelectionModified" 1
	Player.AuxiliaryVariableSetFloat "*PLC_bIsSelectedCalendarDateFuture" 0
	Player.AuxiliaryVariableSetFloat "*PLC_bIsSelectedCalendarDateTracked" 0

	Player.AuxiliaryVariableSetFloat "*PLC_iSelectedDay" -1
	Player.AuxiliaryVariableSetFloat "*PLC_iSelectedMonth" -1
	Player.AuxiliaryVariableSetFloat "*PLC_iSelectedYear" -1

	Player.AuxiliaryVariableSetFloat "*PLC_bIsCalendarSummaryModified" 1

	; Clean-Up

	Sv_Destruct sSelectedDate

end
