begin function { string_var sDate }

	; Compiles the calendar notes for a day tile and stores them in the view model.
	; The UI control loop owns writing this value into the actual menu tile.
	; sDate is in YYYY-MM-DD format (1-indexed month, zero-padded).

	; UDFs

	ref GetCalendarSummaryStringUDF = CompileScript "PipLog\Calendar\GetCalendarSummaryString.gek"

	; Main

	string_var sSummary = ""

	if eval (Sv_Length sDate) > 0
		let sSummary := (Call GetCalendarSummaryStringUDF sDate)
	else
		let sSummary := "No date selected."
	endif

	Player.AuxiliaryVariableSetString "*PLC_sCalendarDateSummary" ($sSummary)
	Player.AuxiliaryVariableSetFloat "*PLC_bIsCalendarSummaryModified" 1

	; Clean-Up

	Sv_Destruct sSummary

end
