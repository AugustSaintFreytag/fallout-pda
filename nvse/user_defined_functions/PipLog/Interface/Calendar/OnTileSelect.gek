begin function { short iMenuId, short iTileId, string_var sTileParam }

	; Handles a click on a calendar grid tile by updating the calendar view model.
	; The UI control loop owns visual selection, tools, and summary text writes.

	Sv_Destruct sTileParam

	; UDFs

	ref ParseStorageDateToComponentsUDF = CompileScript "PipLog\DateTime\ParseStorageDateToComponents.gek"
	ref OnTileDeselectUDF = CompileScript "PipLog\Interface\Calendar\OnTileDeselect.gek"
	ref GetPlayerDateReminderUDF = CompileScript "PipLog\Reminder\GetPlayerDateReminder.gek"

	; State

	string_var sCurrentSelectedDate = Player.AuxiliaryVariableGetString "*PLC_sSelectedCalendarDate"

	; Main

	string_var sComponent = GetActiveUIComponentFullName

	PrintC "Clicked on tile '%z'." sComponent

	Sv_Replace "MapMenu/CM_MainRect/CM_CalendarRect/CM_CalendarGrids/|" sComponent
	Sv_Replace "/CM_Box_Main|" sComponent

	if eval (sComponent != sCurrentSelectedDate)
		array_var aComponents = (Call ParseStorageDateToComponentsUDF sComponent)

		if eval aComponents == Ar_Null
			PrintC "Could not select tile, date string '%z' is invalid." (sComponent)

			let aComponents := Ar_Null
			Sv_Destruct sComponent, sCurrentSelectedDate

			return
		endif

		short iNewYear = aComponents[0]
		short iNewMonth = aComponents[1]
		short iNewDay = aComponents[2]

		let aComponents := Ar_Null

		Player.AuxiliaryVariableSetString "*PLC_sPreviousSelectedCalendarDate" ($sCurrentSelectedDate)
		Player.AuxiliaryVariableSetString "*PLC_sSelectedCalendarDate" ($sComponent)
		Player.AuxiliaryVariableSetFloat "*PLC_bIsCalendarSelectionModified" 1

		Player.AuxiliaryVariableSetFloat "*PLC_iSelectedDay" iNewDay
		Player.AuxiliaryVariableSetFloat "*PLC_iSelectedMonth" iNewMonth
		Player.AuxiliaryVariableSetFloat "*PLC_iSelectedYear" iNewYear

		if eval (iNewYear > GameYear) || ((iNewYear == GameYear) && (iNewMonth > GameMonth)) || ((iNewYear == GameYear) && (iNewMonth == GameMonth) && (iNewDay > GameDay))
			short bIsTracked = (Call GetPlayerDateReminderUDF sComponent)

			Player.AuxiliaryVariableSetFloat "*PLC_bIsSelectedCalendarDateFuture" 1
			Player.AuxiliaryVariableSetFloat "*PLC_bIsSelectedCalendarDateTracked" bIsTracked
		else
			Player.AuxiliaryVariableSetFloat "*PLC_bIsSelectedCalendarDateFuture" 0
			Player.AuxiliaryVariableSetFloat "*PLC_bIsSelectedCalendarDateTracked" 0
		endif

		Player.AuxiliaryVariableSetFloat "*PLC_bIsCalendarSummaryModified" 1
	else
		Call OnTileDeselectUDF
	endif

	; Clean-Up

	Sv_Destruct sComponent, sCurrentSelectedDate

end
