begin function { string_var sText, short iNumCharactersPerLine }

	; Returns an approximate wrapped text height for UI layout.

	; Constants

	float fLineHeight = 32

	; Main

	if iNumCharactersPerLine <= 0
		let iNumCharactersPerLine := 32
	endif

	short iNumCharacters = Sv_Length sText
	short iNumWrappedLines = ((iNumCharacters + iNumCharactersPerLine - 1) / iNumCharactersPerLine)
	short iNumExplicitLines = (Sv_Count, "%r" sText)
	short iNumLines = iNumWrappedLines + iNumExplicitLines

	if iNumLines < 1
		let iNumLines := 1
	endif

	float fTextHeight = iNumLines * fLineHeight

	SetFunctionValue fTextHeight

end
