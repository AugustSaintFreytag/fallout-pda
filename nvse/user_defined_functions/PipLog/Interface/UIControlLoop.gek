begin function {}

	; Single source of truth for MapMenu XML state.
	; Event handlers update the Pip-Log view model; this loop applies it to UI tiles.

	; View mode: 0 = None, 1=calendar view, 2 = events view, 3 = journal view

	if eval !(MenuMode 1023)
		return
	endif

	; UDFs

	ref GenerateCalendarTilesUDF = CompileScript "PipLog\Interface\Calendar\GenerateCalendarTiles.gek"
	ref PulseSelectedDateTileUDF = CompileScript "PipLog\Interface\Calendar\PulseSelectedDateTile.gek"
	ref GenerateEventListUDF = CompileScript "PipLog\Interface\Event\GenerateEventList.gek"
	ref GetEventByIdUDF = CompileScript "PipLog\Event\GetEventById.gek"
	ref GetEventDateLabelUDF = CompileScript "PipLog\Interface\Event\GetEventDateLabel.gek"
	ref UpdateSelectedDaySummaryUDF = CompileScript "PipLog\Interface\Calendar\UpdateSelectedDaySummary.gek"

	; Core State

	short iFrame = Player.AuxiliaryVariableGetFloat "*PLC_iFrame"
	short iSelectedTab = GetUIFloat "MapMenu/GLOW_BRANCH/MM_Tabline/_CurrentTab"
	short iViewMode = Player.AuxiliaryVariableGetFloat "*PLC_iViewMode"

	short bIsLogOpen = Player.AuxiliaryVariableGetFloat "*PLC_bIsLogOpen"
	
	short bDidGenerateCalendar = Player.AuxiliaryVariableGetFloat "*PLC_bDidGenerateCalendar"
	short bIsCalendarSummaryModified = Player.AuxiliaryVariableGetFloat "*PLC_bIsCalendarSummaryModified"
	short bIsCalendarSelectionModified = Player.AuxiliaryVariableGetFloat "*PLC_bIsCalendarSelectionModified"
	short bIsCalendarViewModified = Player.AuxiliaryVariableGetFloat "*PLC_bIsCalendarViewModified"
	
	short bIsSelectedCalendarDateFuture = Player.AuxiliaryVariableGetFloat "*PLC_bIsSelectedCalendarDateFuture"
	short bIsSelectedCalendarDateTracked = Player.AuxiliaryVariableGetFloat "*PLC_bIsSelectedCalendarDateTracked"

	short iIntervalKind = Player.AuxiliaryVariableGetFloat "*PLC_iIntervalKind"
	short bIsEventListModified = Player.AuxiliaryVariableGetFloat "*PLC_bIsEventListModified"
	short bIsEventSelectionModified = Player.AuxiliaryVariableGetFloat "*PLC_bIsEventSelectionModified"
	short bIsSelectedEventPlayer = Player.AuxiliaryVariableGetFloat "*PLC_bIsSelectedEventPlayer"

	string_var sCalendarDateSummary = Player.AuxiliaryVariableGetString "*PLC_sCalendarDateSummary"
	string_var sPreviousSelectedCalendarDate = Player.AuxiliaryVariableGetString "*PLC_sPreviousSelectedCalendarDate"
	string_var sSelectedCalendarDate = Player.AuxiliaryVariableGetString "*PLC_sSelectedCalendarDate"
	string_var sHoveredCalendarDate = Player.AuxiliaryVariableGetString "*PLC_sHoveredCalendarDate"
	string_var sPreviousSelectedEventTileName = Player.AuxiliaryVariableGetString "*PLC_sPreviousSelectedEventTileName"
	string_var sSelectedEventTileName = Player.AuxiliaryVariableGetString "*PLC_sSelectedEventTileName"
	string_var sSelectedEventId = Player.AuxiliaryVariableGetString "*PLC_sSelectedEventId"

	; Frame

	let iFrame += 1
	Player.AuxiliaryVariableSetFloat "*PLC_iFrame" iFrame

	; Main

	if eval (iSelectedTab != 3)
		let iViewMode := 0
		Player.AuxiliaryVariableSetFloat "*PLC_iViewMode" 0
	endif

	if eval (iViewMode < 0) || (iViewMode > 3)
		let iViewMode := 0
		Player.AuxiliaryVariableSetFloat "*PLC_iViewMode" 0
	endif

	if eval (iIntervalKind < 0) || (iIntervalKind > 2)
		let iIntervalKind := 0
		Player.AuxiliaryVariableSetFloat "*PLC_iIntervalKind" 0
	endif

	; General Visibility

	if eval (iViewMode > 0) && (!bIsLogOpen)
		PrintC "View mode is %g, opening log view." iViewMode

		Player.AuxiliaryVariableSetFloat "*PLC_bIsLogOpen" 1

		SetUIFloatAlt "MapMenu/GLOW_BRANCH/MM_MainRect/visible" 0
		SetUIFloatAlt "MapMenu/GLOW_BRANCH/MM_MainRect/MM_ButtonRect/MM_ButtonA/target" 0
		SetUIFloatAlt "MapMenu/GLOW_BRANCH/MM_MainRect/MM_ButtonRect/MM_ButtonX/target" 0
		SetUIFloatAlt "MapMenu/GLOW_BRANCH/MM_MainRect/MM_ButtonRect/MM_ButtonY/target" 0
		SetUIFloatAlt "MapMenu/CM_MainRect/CM_ButtonRect/CM_Button1/_toggled" 1
		SetUIStringAlt "MapMenu/CM_MainRect/CM_ButtonRect/CM_Button1/string" "Notes"
	elseif eval (iViewMode == 0) && (bIsLogOpen)
		PrintC "View mode is %g, closing log view." iViewMode

		Player.AuxiliaryVariableSetFloat "*PLC_bIsLogOpen" 0

		SetUIFloatAlt "MapMenu/GLOW_BRANCH/MM_MainRect/visible" 1
		SetUIFloatAlt "MapMenu/GLOW_BRANCH/MM_MainRect/MM_ButtonRect/MM_ButtonA/target" 1
		SetUIFloatAlt "MapMenu/GLOW_BRANCH/MM_MainRect/MM_ButtonRect/MM_ButtonX/target" 1
		SetUIFloatAlt "MapMenu/GLOW_BRANCH/MM_MainRect/MM_ButtonRect/MM_ButtonY/target" 1
		SetUIFloatAlt "MapMenu/CM_MainRect/CM_ButtonRect/CM_Button1/_toggled" 0
		SetUIStringAlt "MapMenu/CM_MainRect/CM_ButtonRect/CM_Button1/string" "Log"
		SetUIFloatAlt "MapMenu/CM_MainRect/CM_DataRect/CM_DataTextRect/CM_TextScrollbar/_toggled" 0
	endif

	; Journal View

	if iViewMode == 3
		SetUIFloatAlt "MapMenu/CM_MainRect/CM_ButtonRect/CM_Button2/_toggled" 1
	else
		SetUIFloatAlt "MapMenu/CM_MainRect/CM_ButtonRect/CM_Button2/_toggled" 0
	endif

	; Events View

	if iViewMode == 2
		SetUIFloatAlt "MapMenu/CM_MainRect/CM_ButtonRect/CM_Button3/_toggled" 1

		if iIntervalKind == 0
			SetUIFloatAlt "MapMenu/CM_MainRect/CM_ButtonRect/CM_Button2/user0" 3
		elseif iIntervalKind == 1
			SetUIFloatAlt "MapMenu/CM_MainRect/CM_ButtonRect/CM_Button2/user0" 0
		else
			SetUIFloatAlt "MapMenu/CM_MainRect/CM_ButtonRect/CM_Button2/user0" 1
		endif

		; DEBUG DEBUG DEBUG
		if eval (iFrame % 60) == 0
			float fScrollDeltaA = (GetUIFloatAlt "MapMenu/CM_MainRect/CM_EventRect/CM_EventTextRect/CM_EventScrollbar/_ScrollDelta")
			float fScrollDeltaB = (GetUIFloatAlt "MapMenu/CM_MainRect/CM_EventRect/CM_EventTextRect/CM_EventScrollbar/_scroll_delta")
			float fScrollCurrentValue = (GetUIFloatAlt "MapMenu/CM_MainRect/CM_EventRect/CM_EventTextRect/CM_EventScrollbar/_current_value")
			float fParentRectY = (GetUIFloatAlt "MapMenu/CM_MainRect/CM_EventRect/CM_EventTextRect/CM_EventParentRect/y")

			PrintC "Event list scroll bar at delta a %.2f, delta b %.2f, current %.2f, parent rect at %.2f" fScrollDeltaA fScrollDeltaB fScrollCurrentValue fParentRectY
		endif
	else
		SetUIFloatAlt "MapMenu/CM_MainRect/CM_ButtonRect/CM_Button3/_toggled" 0
	endif

	if eval (iViewMode == 1) && ((Sv_Length sSelectedCalendarDate) > 0)
		SetUIFloatAlt "MapMenu/CM_MainRect/CM_DataRect/CM_ToolsRect/CM_CustomButton/target" 1
	else
		SetUIFloatAlt "MapMenu/CM_MainRect/CM_DataRect/CM_ToolsRect/CM_CustomButton/target" 0
	endif

	; Calendar View (Tiles)

	if iViewMode == 1
		if eval (!bDidGenerateCalendar) || (bIsCalendarViewModified)
			PrintC "Generating calendar tiles. View mode: %g, did generate: %g, view modified: %g" iViewMode bDidGenerateCalendar bIsCalendarViewModified
			Call GenerateCalendarTilesUDF
			let bDidGenerateCalendar := 1
		else
			;Call PulseSelectedDateTileUDF
		endif
	endif

	; Calendar View (Summary Text)

	if eval (iViewMode == 1) && (bIsCalendarSummaryModified || bIsCalendarSelectionModified || bIsCalendarViewModified)
		string_var sSummaryDate = ""

		if eval (Sv_Length sHoveredCalendarDate) > 0
			let sSummaryDate := Sv_Construct "%z" sHoveredCalendarDate
		elseif eval (Sv_Length sSelectedCalendarDate) > 0
			let sSummaryDate := Sv_Construct "%z" sSelectedCalendarDate
		endif

		Call UpdateSelectedDaySummaryUDF sSummaryDate

		Sv_Destruct sCalendarDateSummary, sSummaryDate
		let sCalendarDateSummary := Player.AuxiliaryVariableGetString "*PLC_sCalendarDateSummary"
		let bIsCalendarSummaryModified := 1
	endif

	if eval (iViewMode == 1) && (bIsCalendarSummaryModified)
		PrintC "Updating calendar summary text. View mode: %g, summary modified: %g" iViewMode bIsCalendarSummaryModified

		SetUIFloatAlt "MapMenu/CM_MainRect/CM_DataRect/CM_DataTextRect/CM_TextScrollbar/_current_value" 0

		short iNumLines = (Sv_Count, "%r" sCalendarDateSummary)
		short iNumLinesFromChars = ((Sv_Length sCalendarDateSummary) / 32)
		float fScrollDelta = ((iNumLinesFromChars + iNumLines) + 8)

		if fScrollDelta < 10
			SetUIFloatAlt "MapMenu/CM_MainRect/CM_DataRect/CM_DataTextRect/CM_TextScrollbar/visible" 0
			SetUIFloatAlt "MapMenu/CM_MainRect/CM_DataRect/CM_DataTextRect/CM_TextScrollbar/_ScrollDelta" 0
		else
			SetUIFloatAlt "MapMenu/CM_MainRect/CM_DataRect/CM_DataTextRect/CM_TextScrollbar/visible" 1
			SetUIFloatAlt "MapMenu/CM_MainRect/CM_DataRect/CM_DataTextRect/CM_TextScrollbar/_ScrollDelta" fScrollDelta
		endif

		SetUIStringAlt "MapMenu/CM_MainRect/CM_DataRect/CM_DataTextRect/CM_DataText/string" ($sCalendarDateSummary)
		Player.AuxiliaryVariableSetFloat "*PLC_bIsCalendarSummaryModified" 0
	endif

	; Calendar View (Selection)

	if eval (iViewMode == 1) && (bIsCalendarSelectionModified) && (bDidGenerateCalendar)
		PrintC "Updating calendar selection. View mode: %g, selection modified: %g, did generate: %g" iViewMode bIsCalendarSelectionModified bDidGenerateCalendar

		if eval (Sv_Length sPreviousSelectedCalendarDate) > 0
			string_var sOldTilePath = Sv_Construct "MapMenu/CM_MainRect/CM_CalendarRect/CM_CalendarGrids/%z/_selected" sPreviousSelectedCalendarDate
			SetUIFloatAlt ($sOldTilePath) 0
			Sv_Destruct sOldTilePath
		endif

		if eval (Sv_Length sSelectedCalendarDate) > 0
			string_var sNewTilePath = Sv_Construct "MapMenu/CM_MainRect/CM_CalendarRect/CM_CalendarGrids/%z/_selected" sSelectedCalendarDate
			SetUIFloatAlt ($sNewTilePath) 1
			Sv_Destruct sNewTilePath
		endif

		if eval (Sv_Length sSelectedCalendarDate) > 0
			if bIsSelectedCalendarDateFuture
				SetUIFloatAlt "MapMenu/CM_MainRect/CM_DataRect/CM_ToolsRect/CM_WaitButton/target" 1
				SetUIFloatAlt "MapMenu/CM_MainRect/CM_DataRect/CM_ToolsRect/CM_TrackButton/target" 1
				SetUIFloatAlt "MapMenu/CM_MainRect/CM_DataRect/CM_ToolsRect/CM_TrackButton/_Value" bIsSelectedCalendarDateTracked
			else
				SetUIFloatAlt "MapMenu/CM_MainRect/CM_DataRect/CM_ToolsRect/CM_WaitButton/target" 0
				SetUIFloatAlt "MapMenu/CM_MainRect/CM_DataRect/CM_ToolsRect/CM_TrackButton/target" 0
				SetUIFloatAlt "MapMenu/CM_MainRect/CM_DataRect/CM_ToolsRect/CM_TrackButton/_Value" 0
			endif
		else
			SetUIFloatAlt "MapMenu/CM_MainRect/CM_DataRect/CM_ToolsRect/CM_WaitButton/target" 0
			SetUIFloatAlt "MapMenu/CM_MainRect/CM_DataRect/CM_ToolsRect/CM_TrackButton/target" 0
			SetUIFloatAlt "MapMenu/CM_MainRect/CM_DataRect/CM_ToolsRect/CM_TrackButton/_Value" 0
		endif

		Player.AuxiliaryVariableSetFloat "*PLC_bIsCalendarSelectionModified" 0
	endif

	; Events View (List)

	if iViewMode == 2
		if bIsEventListModified
			PrintC "Generating event list. View mode: %g, list modified: %g" iViewMode bIsEventListModified
			Call GenerateEventListUDF
		endif
	endif

	; Events View (Selection)

	if eval (iViewMode == 2) && (bIsEventSelectionModified)
		PrintC "Updating event selection. View mode: %g, selection modified: %g" iViewMode bIsEventSelectionModified

		if eval (Sv_Length sPreviousSelectedEventTileName) > 0
			string_var sOldEventTilePath = Sv_Construct "MapMenu/CM_MainRect/CM_EventRect/CM_EventTextRect/CM_EventParentRect/%z/_selected" sPreviousSelectedEventTileName
			SetUIFloatAlt ($sOldEventTilePath) 0
			Sv_Destruct sOldEventTilePath
		endif

		if eval (Sv_Length sSelectedEventId) > 0
			if eval (Sv_Length sSelectedEventTileName) > 0
				string_var sNewEventTilePath = Sv_Construct "MapMenu/CM_MainRect/CM_EventRect/CM_EventTextRect/CM_EventParentRect/%z/_selected" sSelectedEventTileName
				SetUIFloatAlt ($sNewEventTilePath) 1
				Sv_Destruct sNewEventTilePath
			endif

			array_var aSelectedEvent = (Call GetEventByIdUDF sSelectedEventId bIsSelectedEventPlayer)

			if eval aSelectedEvent == Ar_Null
				SetUIFloatAlt "MapMenu/CM_MainRect/CM_EventRect/CM_EventSide/_tileselected" 0
				SetUIFloatAlt "MapMenu/CM_MainRect/CM_EventRect/CM_EventSide/_editable" 0
			else
				string_var sSelectedEventName = aSelectedEvent["name"]
				string_var sSelectedEventDate = aSelectedEvent["date"]
				string_var sSelectedEventDateLabel = (Call GetEventDateLabelUDF sSelectedEventDate)

				SetUIFloatAlt "MapMenu/CM_MainRect/CM_EventRect/CM_EventSide/_tileselected" 1
				SetUIFloatAlt "MapMenu/CM_MainRect/CM_EventRect/CM_EventSide/_editable" bIsSelectedEventPlayer
				SetUIStringAlt "MapMenu/CM_MainRect/CM_EventRect/CM_EventSide/CM_Event_Side_1R/string" ($sSelectedEventName)
				SetUIStringAlt "MapMenu/CM_MainRect/CM_EventRect/CM_EventSide/CM_Event_Side_2R/string" ($sSelectedEventDateLabel)

				Sv_Destruct sSelectedEventName, sSelectedEventDate, sSelectedEventDateLabel
			endif

			let aSelectedEvent := Ar_Null
		else
			SetUIFloatAlt "MapMenu/CM_MainRect/CM_EventRect/CM_EventSide/_tileselected" 0
			SetUIFloatAlt "MapMenu/CM_MainRect/CM_EventRect/CM_EventSide/_editable" 0
		endif

		Player.AuxiliaryVariableSetFloat "*PLC_bIsEventSelectionModified" 0
	endif

	; Clean-Up

	Sv_Destruct sCalendarDateSummary, sPreviousSelectedCalendarDate, sSelectedCalendarDate, sHoveredCalendarDate, sPreviousSelectedEventTileName, sSelectedEventTileName, sSelectedEventId

end
