begin function { array_var aEvents }

	; Adds all event-list rows for a decoded event array.
	; Returns the number of rows added.

	; UDFs

	ref AddEventToListUDF = CompileScript "PipLog\Interface\Event\AddEventToList.gek"
	ref AddEventAnchorElementToListUDF = CompileScript "PipLog\Interface\Event\AddEventAnchorElementToList.gek"

	; State

	short iTileIndex = 0
	short iNumEvents = Ar_Size aEvents

	; Main

	Call AddEventAnchorElementToListUDF 0

	if iNumEvents == -1
		Call AddEventAnchorElementToListUDF 1
		SetFunctionValue 0
		return
	endif

	while iTileIndex < iNumEvents
		array_var aEvent = aEvents[iTileIndex]

		Call AddEventToListUDF aEvent iTileIndex

		let aEvent := Ar_Null
		let iTileIndex += 1
	loop

	Call AddEventAnchorElementToListUDF 1

	SetFunctionValue iTileIndex

end
