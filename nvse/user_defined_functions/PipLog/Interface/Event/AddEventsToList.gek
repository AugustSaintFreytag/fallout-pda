begin function { array_var aEvents }

	; Adds all event-list rows for a decoded event array.
	; Returns the number of rows added.

	; UDFs

	ref AddEventToListUDF = CompileScript "PipLog\Interface\Event\AddEventToList.gek"

	; Main

	if eval (Ar_Size aEvents) <= 0
		return
	endif

	foreach array_var aElement <- aEvents
		array_var aEvent = aElement["value"]
		Call AddEventToListUDF aEvent iTileIndex

		let aEvent := Ar_Null
	loop

end
