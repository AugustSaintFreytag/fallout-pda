begin function { array_var aEvent, short iYear }

	; Checks for special events by reference and allows renaming them.

	; UDFs

	ref GetBirthdayNumeralUDF = CompileScript "PipLog\Event\GetBirthdayNumeral.gek"
	ref GetOrdinalSuffixUDF = CompileScript "PipLog\DateTime\GetOrdinalSuffix.gek"

	; Main

	string_var sName = aEvent["name"]
	string_var sReference = ""

	if eval (Ar_HasKey aEvent "reference")
		let sReference := aEvent["reference"]
	endif

	; Checks

	if eval sReference == "birthday"
		string_var sDate = aEvent["date"]
		string_var sPlayerName = (GetName Player)

		if iYear == 0
			let iYear := GameYear
		endif

		short iNumBirthday = (Call GetBirthdayNumeralUDF iYear)
		string_var sOrdinalSuffix = (Call GetOrdinalSuffixUDF iNumBirthday)

		if iNumBirthday > 0
			let sName := Sv_Construct "%z's %g%z Birthday" sPlayerName iNumBirthday sOrdinalSuffix
		else
			let sName := Sv_Construct "%z's Birthday" sPlayerName
		endif

		Sv_Destruct sDate, sPlayerName
	endif

	; Return

	SetFunctionValue sName

	; Clean-Up

	Sv_Destruct sName, sReference

end