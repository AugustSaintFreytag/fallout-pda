begin function { array_var aEvent }

	; Returns the selected event description text.

	; UDFs

	ref GetBirthdayEventDescriptionForPlayerUDF = CompileScript "PipLog\Event\GetBirthdayEventDescriptionForPlayer.gek"

	; Main

	if eval (aEvent == Ar_Null) || ((Ar_Size aEvent) == -1)
		SetFunctionValue ""
		return
	endif

	if eval !(Ar_HasKey aEvent, "description")
		SetFunctionValue ""
		return
	endif

	SetFunctionValue aEvent["description"]

end
