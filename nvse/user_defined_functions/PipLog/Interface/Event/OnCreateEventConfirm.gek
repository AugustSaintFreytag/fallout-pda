begin function { string_var sEventTitle }

	; Creates a one-off player event for the selected calendar date.
	; Empty titles or missing selected dates are ignored.

	; Guards

	if eval (Sv_Length sEventTitle) == 0
		return
	endif

	string_var sSelectedDate = Player.AuxiliaryVariableGetString "*PLC_sSelectedCalendarDate"

	if eval (Sv_Length sSelectedDate) == 0
		Sv_Destruct sSelectedDate
		return
	endif

	; UDFs

	ref ParseStorageDateToComponentsUDF = CompileScript "PipLog\DateTime\ParseStorageDateToComponents.gek"
	ref AddPlayerEventUDF = CompileScript "PipLog\Event\AddPlayerEvent.gek"

	; Main

	array_var aDate = (Call ParseStorageDateToComponentsUDF sSelectedDate)

	if eval aDate == Ar_Null
		Sv_Destruct sSelectedDate
		return
	endif

	Call AddPlayerEventUDF aDate sEventTitle 0

	Player.AuxiliaryVariableSetFloat "*PLC_bIsEventListModified" 1
	Player.AuxiliaryVariableSetFloat "*PLC_bIsCalendarViewModified" 1
	Player.AuxiliaryVariableSetFloat "*PLC_bIsCalendarSummaryModified" 1

	; Clean-Up

	Sv_Destruct sSelectedDate
	let aDate := Ar_Null

end
