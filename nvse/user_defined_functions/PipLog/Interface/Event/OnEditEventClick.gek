begin function { short iMenuId, short iTileId, string_var sTileName }

	; Opens a text input prompt to rename the currently selected player event.

	; Guards

	if eval !(MenuMode 1023)
		return
	endif

	if Player.AuxiliaryVariableGetFloat "*PLC_iViewMode" != 2
		return
	endif

	if Player.AuxiliaryVariableGetFloat "*PLC_bIsSelectedEventPlayer" == 0
		return
	endif

	; UDFs

	ref GetEventByIdUDF = CompileScript "PipLog\Event\GetEventById.gek"
	ref OnEditEventConfirmUDF = CompileScript "PipLog\Interface\Event\OnEditEventConfirm.gek"

	; State

	string_var sSelectedEventId = Player.AuxiliaryVariableGetString "*PLC_sSelectedEventId"

	; Main

	if eval (Sv_Length sSelectedEventId) == 0
		Sv_Destruct sSelectedEventId
		return
	endif

	array_var aEvent = (Call GetEventByIdUDF sSelectedEventId 1)

	if eval aEvent == Ar_Null
		Sv_Destruct sSelectedEventId
		let aEvent := Ar_Null
		return
	endif

	ShowTextInputMenu OnEditEventConfirmUDF 500 160 "Event title:"
	SetTextInputString "%z" aEvent["name"]

	; Clean-Up

	Sv_Destruct sSelectedEventId
	let aEvent := Ar_Null

end
