begin function { array_var aEvent, short iTileIndex }

	; Adds a single event-list row for a decoded event.

	; UDFs

	; ref GetEventListRowHeightUDF = CompileScript "PipLog\Interface\Event\GetEventListRowHeight.gek"

	; Main

	if eval (aEvent == Ar_Null) || ((Ar_Size aEvent) == -1)
		PrintC "Cannot add event to UI list at index %g, event is either null or invalid." iTileIndex
		return
	endif

	string_var sEventId = aEvent["id"]
	string_var sEventDate = aEvent["date"]
	string_var sEventName = aEvent["name"]

	short iEventSourceKind = 0

	if eval (Ar_HasKey aEvent, "_source")
		let iEventSourceKind := aEvent["_source"]
	endif

	; float fEventHeight = (Call GetEventListRowHeightUDF sEventName)
	float fEventHeight = 42 ; Fixed height for testing
	float fEventY = iTileIndex * fEventHeight
	
	string_var sTileInsertCommand = Sv_Construct "MapMenu/CM_MainRect/CM_EventRect/CM_EventTextRect/CM_EventParentRect|CM_Event_Template|CM_Event%g" iTileIndex
	string_var sTileBasePath = Sv_Construct "MapMenu/CM_MainRect/CM_EventRect/CM_EventTextRect/CM_EventParentRect/CM_Event%g" iTileIndex
	string_var sTilePropertyPath = ""

	AddTileFromTemplate ($sTileInsertCommand)

	let sTilePropertyPath := Sv_Construct "%z/string" sTileBasePath
	SetUIStringAlt ($sTilePropertyPath) ($sEventName)

	let sTilePropertyPath := Sv_Construct "%z/_event_id" sTileBasePath
	SetUIStringAlt ($sTilePropertyPath) ($sEventId)

	let sTilePropertyPath := Sv_Construct "%z/_event_date" sTileBasePath
	SetUIStringAlt ($sTilePropertyPath) ($sEventDate)

	let sTilePropertyPath := Sv_Construct "%z/_source" sTileBasePath
	SetUIFloatAlt ($sTilePropertyPath) iEventSourceKind

	let sTilePropertyPath := Sv_Construct "%z/y" sTileBasePath
	SetUIFloatAlt ($sTilePropertyPath) fEventY

	let sTilePropertyPath := Sv_Construct "%z/height" sTileBasePath
	SetUIFloatAlt ($sTilePropertyPath) fEventHeight

	let sTilePropertyPath := Sv_Construct "%z/_selected" sTileBasePath
	SetUIFloatAlt ($sTilePropertyPath) 0

	; Clean-Up

	Sv_Destruct sEventId, sEventDate, sEventName, sTileInsertCommand, sTileBasePath, sTilePropertyPath

end
