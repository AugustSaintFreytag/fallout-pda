begin function {}

	; Updates the event list scrollbar from the XML-computed tail anchor position.

	; Main

	float fTailY = GetUIFloatAlt "MapMenu/CM_MainRect/CM_EventRect/CM_EventListRect/CM_EventParentRect/CM_EventAnchor_Tail/y"
	float fTailHeight = GetUIFloatAlt "MapMenu/CM_MainRect/CM_EventRect/CM_EventListRect/CM_EventParentRect/CM_EventAnchor_Tail/height"
	float fScrollDelta = GetUIFloatAlt "MapMenu/CM_MainRect/CM_EventRect/CM_EventListRect/CM_EventScrollbar/_ScrollDelta"
	float fMeasuredContentHeight = fTailY + fTailHeight
	float fMeasuredItems = 0

	if fScrollDelta > 0
		let fMeasuredItems := fMeasuredContentHeight / fScrollDelta
	endif

	SetUIFloatAlt "MapMenu/CM_MainRect/CM_EventRect/CM_EventListRect/CM_EventScrollbar/_number_of_items" fMeasuredItems

end
