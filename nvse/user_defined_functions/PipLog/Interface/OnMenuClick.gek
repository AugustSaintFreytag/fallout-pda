begin function { short iMenuID, short iTileID, string_var sTileParam }

	; Handles clicks on the Log toggle (510), Calendar/Journal toggle (511),
	; Events toggle (512), and month navigation arrows (513/514).
	; Buttons 515+ are deferred to later phases.

	Sv_Destruct sTileParam

	; Guards

	if !(IsMenuOpen 1023)
		return
	endif

	if GetUIFloat "MapMenu/GLOW_BRANCH/MM_Tabline/_CurrentTab" != 3
		return
	endif

	if Menumode 3
		return
	endif

	float fNow = GetCurrentRealTime

	if fNow - Player.AuxiliaryVariableGetFloat "*PLC_fLastClickRealTime" < 0.15
		return
	endif

	Player.AuxiliaryVariableSetFloat "*PLC_fLastClickRealTime" fNow

	; UDFs

	ref OnTileDeselectUDF = CompileScript "PipLog\Interface\Calendar\OnTileDeselect.gek"

	; Main

	short bButton1Target = GetUIFloat "MapMenu/CM_MainRect/CM_ButtonRect/CM_Button1/target" == 1
	short bButton2Target = GetUIFloat "MapMenu/CM_MainRect/CM_ButtonRect/CM_Button2/target" == 1
	short bButton3Target = GetUIFloat "MapMenu/CM_MainRect/CM_ButtonRect/CM_Button3/target" == 1

	if eval (iTileID >= 510) && (iTileID <= 512)
		if eval (iTileID == 510) && (bButton1Target)
			short bToggled = GetUIFloat "MapMenu/CM_MainRect/CM_ButtonRect/CM_Button1/_toggled"
			short bNowToggled = 1 - bToggled
			SetUIFloatAlt "MapMenu/CM_MainRect/CM_ButtonRect/CM_Button1/_toggled" bNowToggled

			if bNowToggled == 1
				SetUIFloatAlt "MapMenu/GLOW_BRANCH/MM_MainRect/visible" 0
				SetUIFloatAlt "MapMenu/GLOW_BRANCH/MM_MainRect/MM_ButtonRect/MM_ButtonA/target" 0
				SetUIFloatAlt "MapMenu/GLOW_BRANCH/MM_MainRect/MM_ButtonRect/MM_ButtonX/target" 0
				SetUIFloatAlt "MapMenu/GLOW_BRANCH/MM_MainRect/MM_ButtonRect/MM_ButtonY/target" 0
			else
				SetUIFloatAlt "MapMenu/GLOW_BRANCH/MM_MainRect/visible" 1
				SetUIFloatAlt "MapMenu/GLOW_BRANCH/MM_MainRect/MM_ButtonRect/MM_ButtonA/target" 1
				SetUIFloatAlt "MapMenu/GLOW_BRANCH/MM_MainRect/MM_ButtonRect/MM_ButtonX/target" 1
				SetUIFloatAlt "MapMenu/GLOW_BRANCH/MM_MainRect/MM_ButtonRect/MM_ButtonY/target" 1
			endif

			Call OnTileDeselectUDF
			StopSound UIMenuCancel
			PlaySound UIPipBoySelect 1
		elseif eval (GetUIFloat "MapMenu/CM_MainRect/CM_ButtonRect/CM_Button1/_toggled" == 1)
			if eval (iTileID == 511 && bButton2Target)
				if eval (GetUIFloat "MapMenu/CM_MainRect/CM_ButtonRect/CM_Button3/_toggled" == 0)
					short bToggled2 = GetUIFloat "MapMenu/CM_MainRect/CM_ButtonRect/CM_Button2/_toggled"
					SetUIFloatAlt "MapMenu/CM_MainRect/CM_ButtonRect/CM_Button2/_toggled" (1 - bToggled2)
				endif
				
				; Event category cycling (when button3 toggled) deferred to later phase
				StopSound UIMenuCancel
				PlaySound UIPipBoySelect 1
			elseif eval (iTileID == 512) && (bButton3Target)
				short bToggled3 = GetUIFloat "MapMenu/CM_MainRect/CM_ButtonRect/CM_Button3/_toggled"
				SetUIFloatAlt "MapMenu/CM_MainRect/CM_ButtonRect/CM_Button3/_toggled" (1 - bToggled3)
				StopSound UIMenuCancel
				PlaySound UIPipBoySelect 1
			endif
		endif
	elseif eval (iTileID == 513) || (iTileID == 514)
		short iCalendarYear = Player.AuxiliaryVariableGetFloat "*PLC_iCalendarYear"
		short iCalendarMonth = Player.AuxiliaryVariableGetFloat "*PLC_iCalendarMonth"

		if iCalendarYear == 0
			let iCalendarYear := GameYear
			let iCalendarMonth := GameMonth
		endif

		if iTileID == 513
			let iCalendarMonth += 1

			if iCalendarMonth > 11
				let iCalendarMonth := 0
				let iCalendarYear += 1
			endif
		else
			let iCalendarMonth -= 1

			if iCalendarMonth < 0
				let iCalendarMonth := 11
				let iCalendarYear -= 1
			endif
		endif

		Player.AuxiliaryVariableSetFloat "*PLC_iCalendarMonth" iCalendarMonth
		Player.AuxiliaryVariableSetFloat "*PLC_iCalendarYear" iCalendarYear
		Player.AuxiliaryVariableSetFloat "*PLC_bDidGenerateCalendar" 0

		Call OnTileDeselectUDF
	endif

end
