begin function { short iMenuId, short iTileId, string_var sTileParam }

	; Handles main Pip-Log buttons and calendar month arrows by mutating the view model.
	; UIControlLoop.gek owns applying those values to menu tiles.

	Sv_Destruct sTileParam

	; Guards

	if eval !(MenuMode 1023)
		return
	endif

	if eval (GetUIFloat "MapMenu/GLOW_BRANCH/MM_Tabline/_CurrentTab") != 3
		return
	endif

	if eval (Player.AuxTimerTimeLeft "PLC_MenuClickDebounceTimer") > 0
		return
	endif

	Player.AuxTimerStart "PLC_MenuClickDebounceTimer" 0.15

	; UDFs

	ref OnTileDeselectUDF = CompileScript "PipLog\Interface\Calendar\OnTileDeselect.gek"
	ref GetStorageDateStringUDF = CompileScript "PipLog\DateTime\GetStorageDateString.gek"
	ref UpdateSelectedDaySummaryUDF = CompileScript "PipLog\Interface\Calendar\UpdateSelectedDaySummary.gek"

	; Main

	short bButton1Target = GetUIFloat "MapMenu/CM_MainRect/CM_ButtonRect/CM_Button1/target" == 1
	short bButton2Target = GetUIFloat "MapMenu/CM_MainRect/CM_ButtonRect/CM_Button2/target" == 1
	short bButton3Target = GetUIFloat "MapMenu/CM_MainRect/CM_ButtonRect/CM_Button3/target" == 1
	short iViewMode = Player.AuxiliaryVariableGetFloat "*PLC_iViewMode"

	if eval (iTileId >= 510) && (iTileId <= 512)
		if eval (iTileId == 510) && (bButton1Target)
			if iViewMode == 0
				let iViewMode := 1
				Player.AuxiliaryVariableSetFloat "*PLC_iViewMode" 1

				if eval (Player.AuxiliaryVariableGetFloat "*PLC_iCalendarYear") == 0
					Player.AuxiliaryVariableSetFloat "*PLC_iCalendarYear" GameYear
					Player.AuxiliaryVariableSetFloat "*PLC_iCalendarMonth" GameMonth
				endif

				string_var sSelectedDate = Player.AuxiliaryVariableGetString "*PLC_sSelectedCalendarDate"

				if eval (Sv_Length sSelectedDate) == 0
					string_var sToday = (Call GetStorageDateStringUDF GameYear GameMonth GameDay)
					
					Player.AuxiliaryVariableErase "*PLC_sPreviousSelectedCalendarDate"
					
					Player.AuxiliaryVariableSetString "*PLC_sSelectedCalendarDate" ($sToday)
					Player.AuxiliaryVariableSetFloat "*PLC_bIsCalendarSelectionModified" 1
					Player.AuxiliaryVariableSetFloat "*PLC_bIsSelectedCalendarDateFuture" 0
					Player.AuxiliaryVariableSetFloat "*PLC_bIsSelectedCalendarDateTracked" 0
					
					Player.AuxiliaryVariableSetFloat "*PLC_iSelectedDay" GameDay
					Player.AuxiliaryVariableSetFloat "*PLC_iSelectedMonth" GameMonth
					Player.AuxiliaryVariableSetFloat "*PLC_iSelectedYear" GameYear

					Call UpdateSelectedDaySummaryUDF sToday
					
					Sv_Destruct sToday
				endif

				Player.AuxiliaryVariableErase "*PLC_sPreviousSelectedCalendarDate"
				Player.AuxiliaryVariableSetFloat "*PLC_bIsCalendarViewModified" 1

				Sv_Destruct sSelectedDate
			else
				let iViewMode := 0
				Player.AuxiliaryVariableSetFloat "*PLC_iViewMode" 0

				Call OnTileDeselectUDF
			endif

			StopSound UIMenuCancel
			PlaySound UIPipBoySelect 1
		elseif iViewMode > 0
			if eval (iTileId == 511) && (bButton2Target)
				if iViewMode == 3
					Player.AuxiliaryVariableSetFloat "*PLC_iViewMode" 1
				elseif iViewMode == 2
					short iEventFilterMode = Player.AuxiliaryVariableGetFloat "*PLC_iEventFilterMode"

					let iEventFilterMode += 1

					if iEventFilterMode > 2
						let iEventFilterMode := 0
					endif

					Player.AuxiliaryVariableSetFloat "*PLC_iEventFilterMode" iEventFilterMode
					Player.AuxiliaryVariableSetFloat "*PLC_bIsEventListModified" 1
					Player.AuxiliaryVariableSetFloat "*PLC_bIsEventSelectionModified" 1
					Player.AuxiliaryVariableErase "*PLC_sSelectedEventId"
					Player.AuxiliaryVariableErase "*PLC_sSelectedEventTileName"
					Player.AuxiliaryVariableErase "*PLC_sPreviousSelectedEventTileName"
					Player.AuxiliaryVariableSetFloat "*PLC_bIsSelectedEventPlayer" 0
				else
					Player.AuxiliaryVariableSetFloat "*PLC_iViewMode" 3
				endif

				StopSound UIMenuCancel
				PlaySound UIPipBoySelect 1
			elseif eval (iTileId == 512) && (bButton3Target)
				if iViewMode == 2
					Player.AuxiliaryVariableSetFloat "*PLC_iViewMode" 1
				else
					Player.AuxiliaryVariableSetFloat "*PLC_iViewMode" 2
					Player.AuxiliaryVariableSetFloat "*PLC_bIsEventListModified" 1
					Player.AuxiliaryVariableSetFloat "*PLC_bIsEventSelectionModified" 1
					Player.AuxiliaryVariableErase "*PLC_sSelectedEventId"
					Player.AuxiliaryVariableErase "*PLC_sSelectedEventTileName"
					Player.AuxiliaryVariableErase "*PLC_sPreviousSelectedEventTileName"
					Player.AuxiliaryVariableSetFloat "*PLC_bIsSelectedEventPlayer" 0
				endif

				StopSound UIMenuCancel
				PlaySound UIPipBoySelect 1
			endif
		endif
	elseif eval (iTileId == 513) || (iTileId == 514)
		short iCalendarYear = Player.AuxiliaryVariableGetFloat "*PLC_iCalendarYear"
		short iCalendarMonth = Player.AuxiliaryVariableGetFloat "*PLC_iCalendarMonth"

		if iCalendarYear == 0
			let iCalendarYear := GameYear
			let iCalendarMonth := GameMonth
		endif

		if iTileId == 513
			let iCalendarMonth += 1

			if iCalendarMonth > 11
				let iCalendarMonth := 0
				let iCalendarYear += 1
			endif
		else
			let iCalendarMonth -= 1

			if iCalendarMonth < 0
				let iCalendarMonth := 11
				let iCalendarYear -= 1
			endif
		endif

		Player.AuxiliaryVariableSetFloat "*PLC_iCalendarMonth" iCalendarMonth
		Player.AuxiliaryVariableSetFloat "*PLC_iCalendarYear" iCalendarYear
		Player.AuxiliaryVariableSetFloat "*PLC_bIsCalendarViewModified" 1
		Player.AuxiliaryVariableSetFloat "*PLC_bDidGenerateCalendar" 0

		Call OnTileDeselectUDF
	endif

end
