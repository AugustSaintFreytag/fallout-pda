begin function { short iMenuId }

	; Updates state variables and marks rendered content as modified to be redrawn on next menu open.
	; Maintain navigational positions and selections for continuity.

	if iMenuId != 1023
		return
	endif

	; Main

	UnloadUIComponent "MapMenu/CM_MainRect/CM_EventRect/CM_EventListRect/CM_EventParentRect"
	UnloadUIComponent "MapMenu/CM_MainRect/CM_JournalRect/CM_JournalTextRect/CM_JournalEntryRect"
	
	Player.AuxiliaryVariableSetFloat "*PLC_bIsLogOpen" 0
	Player.AuxiliaryVariableSetFloat "*PLC_bIsCalendarViewModified" 1
	Player.AuxiliaryVariableSetFloat "*PLC_bIsCalendarSummaryModified" 1
	Player.AuxiliaryVariableSetFloat "*PLC_bIsCalendarSelectionModified" 1
	Player.AuxiliaryVariableSetFloat "*PLC_bIsEventListModified" 1
	Player.AuxiliaryVariableSetFloat "*PLC_bIsEventSelectionModified" 1
	Player.AuxiliaryVariableSetFloat "*PLC_bIsJournalListModified" 1
	
	Player.AuxiliaryVariableErase "*PLC_sHoveredCalendarDate"
	Player.AuxiliaryVariableErase "*PLC_sPreviousSelectedCalendarDate"
	Player.AuxiliaryVariableErase "*PLC_sCalendarDateSummary"
	Player.AuxiliaryVariableErase "*PLC_sPreviousSelectedEventTileName"
	Player.AuxiliaryVariableErase "*PLC_sEditJournalEntryId"
	Player.AuxiliaryVariableErase "*PLC_aDisplayedEventIds"
	Player.AuxiliaryVariableErase "*PLC_aDisplayedJournalEntryIds"

end
