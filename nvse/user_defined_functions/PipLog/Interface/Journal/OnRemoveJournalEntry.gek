begin function { short iMenuId, short iTileId, string_var sTileParam }

	; Deletes the clicked journal entry.

	; Guards

	if eval !(MenuMode 1023)
		Sv_Destruct sTileParam
		return
	endif

	if Player.AuxiliaryVariableGetFloat "*PLC_iViewMode" != 3
		Sv_Destruct sTileParam
		return
	endif

	; UDFs

	ref DeleteJournalEntryUDF = CompileScript "PipLog\Journal\DeleteJournalEntry.gek"
	ref GetJournalEntriesUDF = CompileScript "PipLog\Journal\GetJournalEntries.gek"
	ref GetTileIndexFromNameUDF = CompileScript "PipLog\Interface\GetTileIndexFromName.gek"

	; State

	string_var sComponent = GetActiveUIComponentFullName
	array_var aJournalEntries = (Call GetJournalEntriesUDF)
	short iNumJournalEntries = Ar_Size aJournalEntries
	short iEntryIndex = Call GetTileIndexFromNameUDF sTileParam

	; Main

	if eval (Sv_Count "EntryDelete", sComponent) == 0
		PrintC "Cannot remove journal entry, active component '%z' is not a delete button." sComponent

		Sv_Destruct sComponent, sTileParam
		let aJournalEntries := Ar_Null
		return
	endif

	if eval (iNumJournalEntries == -1) || (iEntryIndex < 0) || (iEntryIndex >= iNumJournalEntries)
		PrintC "Cannot remove journal entry, could not resolve valid entry index %g from '%z'." iEntryIndex sTileParam

		Sv_Destruct sComponent, sTileParam
		let aJournalEntries := Ar_Null
		return
	endif

	Call DeleteJournalEntryUDF iEntryIndex

	Player.AuxiliaryVariableSetFloat "*PLC_bIsJournalListModified" 1

	; Clean-Up

	Sv_Destruct sComponent, sTileParam
	let aJournalEntries := Ar_Null

end
