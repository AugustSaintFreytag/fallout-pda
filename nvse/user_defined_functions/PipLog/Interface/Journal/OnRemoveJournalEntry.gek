begin function { short iMenuId, short iTileId, string_var sTileName }

	; Deletes the clicked displayed journal entry.

	; UDFs

	ref RemoveJournalEntryUDF = CompileScript "PipLog\Journal\RemoveJournalEntry.gek"
	ref GetDisplayedJournalEntryForIndexUDF = CompileScript "PipLog\Interface\Journal\GetDisplayedJournalEntryForIndex.gek"
	ref GetJournalEntryIndexFromRemoveButtonPathUDF = CompileScript "PipLog\Interface\Journal\GetJournalEntryIndexFromRemoveButtonPath.gek"
	ref EllipsizeUDF = CompileScript "PipLog\Utils\Ellipsize.gek"

	; Guards

	if eval !(MenuMode 1023)
		PrintC "Cannot delete journal entry, incompatible menu mode %g (expected: 1023)." (GetActiveMenuMode)
		return
	endif

	if Player.AuxiliaryVariableGetFloat "*PLC_iViewMode" != 3
		PrintC "Cannot delete journal entry, incompatible view mode %g (expected: 3)." (Player.AuxiliaryVariableGetFloat "*PLC_iViewMode")
		return
	endif

	; State

	string_var sActiveComponentPath = GetActiveUIComponentFullName
	string_var sCompPreview = (Call EllipsizeUDF sActiveComponentPath 36)
	short iIndex = Call GetJournalEntryIndexFromRemoveButtonPathUDF sActiveComponentPath

	PrintC "Received click on journal entry delete button, name '%z', id '%g', path '%z'." sTileName iTileId sCompPreview

	array_var aJournalEntry = (Call GetDisplayedJournalEntryForIndexUDF iIndex)

	; Main

	if eval (aJournalEntry == Ar_Null) || ((Ar_Size aJournalEntry) == -1)
		PrintC "Cannot remove journal entry, could not resolve displayed index %g from '%z'." iIndex sActiveComponentPath

		Sv_Destruct sActiveComponentPath, sCompPreview
		let aJournalEntry := Ar_Null

		return
	endif

	string_var sJournalEntryId = aJournalEntry["id"]

	Call RemoveJournalEntryUDF sJournalEntryId

	Player.AuxiliaryVariableSetFloat "*PLC_bIsJournalListModified" 1

	; Clean-Up

	Sv_Destruct sActiveComponentPath, sCompPreview, sJournalEntryId
	let aJournalEntry := Ar_Null

end
