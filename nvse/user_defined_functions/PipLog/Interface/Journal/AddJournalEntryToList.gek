begin function { array_var aJournalEntry, short iIndex }

	; Adds a single journal-list row for a decoded journal entry.

	; Main

	if eval (aJournalEntry == Ar_Null) || ((Ar_Size aJournalEntry) == -1)
		PrintC "Cannot add journal entry to UI list at tile index %g, entry is either null or invalid." iIndex
		return
	endif

	; UDFs

	ref ParseStorageDateToComponentsUDF = CompileScript "PipLog\DateTime\ParseStorageDateToComponents.gek"
	ref GetVerbalDateStringUDF = CompileScript "PipLog\DateTime\GetVerbalDateString.gek"

	string_var sJournalEntryId = aJournalEntry["id"]
	string_var sJournalEntryText = aJournalEntry["text"]
	string_var sJournalEntryLocation = aJournalEntry["location"]
	string_var sJournalEntryDatetime = aJournalEntry["datetime"]
	string_var sJournalEntryDisplayDate = Sv_Construct "%z" sJournalEntryDatetime
	array_var aDateTimeParts = Sv_Split sJournalEntryDatetime, " "

	if eval (Ar_Size aDateTimeParts) > 0
		string_var sJournalEntryDate = aDateTimeParts[0]
		array_var aDateComponents = (Call ParseStorageDateToComponentsUDF sJournalEntryDate)

		if eval aDateComponents != Ar_Null
			let sJournalEntryDisplayDate := (Call GetVerbalDateStringUDF aDateComponents)
		endif

		Sv_Destruct sJournalEntryDate
		let aDateComponents := Ar_Null
	endif

	let aDateTimeParts := Ar_Null

	string_var sParentPath = "MapMenu/CM_MainRect/CM_JournalRect/CM_JournalTextRect/CM_JournalEntryRect"
	string_var sTileInsertCommand = Sv_Construct "%z|CM_Journal_Template|CM_Entry%g" sParentPath iIndex
	string_var sTileInnerPath = Sv_Construct "%z/CM_Entry%g/CM_JournalEntry" sParentPath iIndex

	; Insertion

	string_var sTilePropertyPath = ""

	AddTileFromTemplate ($sTileInsertCommand)

	let sTilePropertyPath := Sv_Construct "%z/_entry" sTileInnerPath
	SetUIStringAlt ($sTilePropertyPath) ($sJournalEntryText)

	let sTilePropertyPath := Sv_Construct "%z/_location" sTileInnerPath
	SetUIStringAlt ($sTilePropertyPath) ($sJournalEntryLocation)

	let sTilePropertyPath := Sv_Construct "%z/_time" sTileInnerPath
	SetUIStringAlt ($sTilePropertyPath) ($sJournalEntryDisplayDate)

	let sTilePropertyPath := Sv_Construct "%z/timestamp/string" sTileInnerPath
	SetUIStringAlt ($sTilePropertyPath) ($sJournalEntryDisplayDate)

	let sTilePropertyPath := Sv_Construct "%z/location/string" sTileInnerPath
	SetUIStringAlt ($sTilePropertyPath) ($sJournalEntryLocation)

	let sTilePropertyPath := Sv_Construct "%z/CM_JournalText/string" sTileInnerPath
	SetUIStringAlt ($sTilePropertyPath) ($sJournalEntryText)

	let sTilePropertyPath := Sv_Construct "%z/user0" sTileInnerPath
	SetUIFloatAlt ($sTilePropertyPath) iIndex

	let sTilePropertyPath := Sv_Construct "%z/EntryEdit/user0" sTileInnerPath
	SetUIFloatAlt ($sTilePropertyPath) iIndex

	let sTilePropertyPath := Sv_Construct "%z/EntryDelete/user0" sTileInnerPath
	SetUIFloatAlt ($sTilePropertyPath) iIndex

	PrintC "Added journal entry with id '%z' to list at index %g." sJournalEntryId iIndex

	; Clean-Up

	Sv_Destruct sJournalEntryId, sJournalEntryText, sJournalEntryLocation, sJournalEntryDatetime, sJournalEntryDisplayDate, sTileInsertCommand, sParentPath, sTileInnerPath, sTilePropertyPath

end
