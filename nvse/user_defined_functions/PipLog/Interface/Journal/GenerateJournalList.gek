begin function {}

	; Rebuilds the journal list UI from decoded player journal entries.

	; UDFs

	ref AddJournalEntriesToListUDF = CompileScript "PipLog\Interface\Journal\AddJournalEntriesToList.gek"
	ref GetJournalEntriesUDF = CompileScript "PipLog\Journal\GetJournalEntries.gek"
	ref UpdateJournalEntryListHeightUDF = CompileScript "PipLog\Interface\Journal\UpdateJournalEntryListHeight.gek"

	; State

	; TODO: Implement sorting journal entries and toggle functionality in UI.
	; short bSort = Player.AuxiliaryVariableGetFloat "PLC_bSort"

	; Add Tile

	UnloadUIComponent "MapMenu/CM_MainRect/CM_JournalRect/CM_JournalTextRect/CM_JournalEntryRect"
	AddTileFromTemplate "MapMenu/CM_MainRect/CM_JournalRect/CM_JournalTextRect|CM_JournalEntryRect_Template|CM_JournalEntryRect"
	
	; SetUIFloatAlt "MapMenu/CM_MainRect/CM_JournalRect/CM_JournalTextRect/_templateheight" 0

	; Prepare Entries

	array_var aJournalEntries = Call GetJournalEntriesUDF
	short iNumJournalEntries = Ar_Size aJournalEntries

	if iNumJournalEntries == -1
		let iNumJournalEntries := 0
	endif

	; Insert Entries

	array_var aDisplayedJournalEntryIds = Ar_Construct "array"
	Call AddJournalEntriesToListUDF aJournalEntries aDisplayedJournalEntryIds

	SetUIFloatAlt "MapMenu/CM_MainRect/CM_JournalRect/CM_JournalTextRect/CM_JournalEntryRect/visible" 1

	; Scroll View

	CallAfterFrames 1.1 UpdateJournalEntryListHeightUDF 1

	; Store View

	Player.AuxiliaryVariableSetFloat "PLC_iNumJournalEntries" iNumJournalEntries

	if eval (Ar_Size aDisplayedJournalEntryIds) > 0
		Player.AuxiliaryVariableSetFromArray "*PLC_aDisplayedJournalEntryIds" aDisplayedJournalEntryIds
	else
		Player.AuxiliaryVariableErase "*PLC_aDisplayedJournalEntryIds"
	endif

	; Conclude

	Player.AuxiliaryVariableSetFloat "*PLC_bIsJournalListModified" 0

	; Clean-Up

	let aJournalEntries := Ar_Null
	let aDisplayedJournalEntryIds := Ar_Null

end
