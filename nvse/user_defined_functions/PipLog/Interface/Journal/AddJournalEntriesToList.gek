begin function { array_var aJournalEntries, array_var aDisplayedJournalEntryIds }

	; Adds all journal-list rows and records their displayed IDs.

	; UDFs

	ref AddJournalEntryToListUDF = CompileScript "PipLog\Interface\Journal\AddJournalEntryToList.gek"
	ref AddJournalEntryAnchorElementToListUDF = CompileScript "PipLog\Interface\Journal\AddJournalEntryAnchorElementToList.gek"

	; State

	short iNumJournalEntries = Ar_Size aJournalEntries

	; Main

	; Insert head anchor element for layout.
	Call AddJournalEntryAnchorElementToListUDF 0

	if iNumJournalEntries == -1
		; Cap off list early with tail element and bail.
		Call AddJournalEntryAnchorElementToListUDF 1
		return
	endif

	short iTileIndex = 0

	foreach (array_var aElement) <- aJournalEntries
		short iIndex = #(aElement["key"])
		array_var aJournalEntry = aElement["value"]

		; Insert element to list.
		Call AddJournalEntryToListUDF aJournalEntry iIndex

		string_var sJournalEntryId = aJournalEntry["id"]
		Ar_Append aDisplayedJournalEntryIds, sJournalEntryId

		Sv_Destruct sJournalEntryId
		let aJournalEntry := Ar_Null
	loop

	; Insert tail anchor element for layout.
	Call AddJournalEntryAnchorElementToListUDF 1

end
