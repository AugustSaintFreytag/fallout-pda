begin function { short iNumEntries }

	; Updates the journal list's scroll extent from the final XML-computed row bounds.

	; Main

	if iNumEntries <= 0
		SetUIFloatAlt "MapMenu/CM_MainRect/CM_JournalRect/CM_JournalTextRect/_templateheight" 0
		return
	endif

	short iLastEntryIndex = iNumEntries - 1
	string_var sEntryYPath = Sv_Construct "MapMenu/CM_MainRect/CM_JournalRect/CM_JournalTextRect/CM_JournalEntryRect/CM_Entry%g/y" iLastEntryIndex
	string_var sEntryHeightPath = Sv_Construct "MapMenu/CM_MainRect/CM_JournalRect/CM_JournalTextRect/CM_JournalEntryRect/CM_Entry%g/height" iLastEntryIndex

	float fEntryY = GetUIFloatAlt ($sEntryYPath)
	float fEntryHeight = GetUIFloatAlt ($sEntryHeightPath)
	float fScrollTemplateHeight = fEntryY + fEntryHeight + 64

	SetUIFloatAlt "MapMenu/CM_MainRect/CM_JournalRect/CM_JournalTextRect/_templateheight" fScrollTemplateHeight

	; Clean-Up

	Sv_Destruct sEntryYPath, sEntryHeightPath

end
