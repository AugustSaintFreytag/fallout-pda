begin function { short iMenuId, short iTileId, string_var sTileName }

	; Opens a text input prompt for editing the clicked displayed journal entry.
	; NOTE: If `GetActiveUIComponentFullName` would return the qualified UI component path, this could be easier.

	; UDFs

	ref GetDisplayedJournalEntryForIndexUDF = CompileScript "PipLog\Interface\Journal\GetDisplayedJournalEntryForIndex.gek"
	ref OnEditJournalEntryConfirmUDF = CompileScript "PipLog\Interface\Journal\OnEditJournalEntryConfirm.gek"
	ref GetJournalEntryIndexFromEditButtonPathUDF = CompileScript "PipLog\Interface\Journal\GetJournalEntryIndexFromEditButtonPath.gek"
	ref EllipsizeUDF = CompileScript "PipLog\Utils\Ellipsize.gek"

	; Guards

	if eval !(MenuMode 1023)
		PrintC "Cannot edit journal entry, incompatible menu mode %g (expected: 1023)." (GetActiveMenuMode)
		return
	endif

	short iViewMode = Player.AuxiliaryVariableGetFloat "*PLC_iViewMode"

	if iViewMode != 3
		PrintC "Cannot edit journal entry, incompatible view mode %g (expected: 3)." iViewMode
		return
	endif

	; State

	string_var sActiveComponentPath = GetActiveUIComponentFullName
	string_var sCompPreview = (Call EllipsizeUDF sActiveComponentPath 36)

	PrintC "Received click on journal entry edit button, name '%z', id '%g', path '%z'." sTileName iTileId sCompPreview

	short iIndex = Call GetJournalEntryIndexFromEditButtonPathUDF sActiveComponentPath
	array_var aJournalEntry = (Call GetDisplayedJournalEntryForIndexUDF iIndex)

	; Main

	if eval (aJournalEntry == Ar_Null) || ((Ar_Size aJournalEntry) == -1)
		PrintC "Cannot edit journal entry, could not resolve displayed index %g from '%z'." iIndex sTileName

		Sv_Destruct sActiveComponentPath, sCompPreview
		let aJournalEntry := Ar_Null

		return
	endif

	string_var sJournalEntryId = aJournalEntry["id"]
	string_var sJournalEntryText = aJournalEntry["text"]
	string_var sEntryPrompt = Sv_Construct "Editing Journal Entry #%g:" (iIndex + 1)

	Player.AuxiliaryVariableSetString "*PLC_sEditJournalEntryId" ($sJournalEntryId)

	ShowTextInputMenu OnEditJournalEntryConfirmUDF 700 500 ($sEntryPrompt)
	SetTextInputString "%z" sJournalEntryText

	; Clean-Up

	Sv_Destruct sActiveComponentPath, sCompPreview, sJournalEntryId, sJournalEntryText, sEntryPrompt
	let aJournalEntry := Ar_Null

end
