begin function { short iMenuId, short iTileId, string_var sTileName }

	; Opens a text input prompt for editing the clicked journal entry.

	; UDFs

	ref GetJournalEntriesUDF = CompileScript "PipLog\Journal\GetJournalEntries.gek"
	ref GetTileIndexFromNameUDF = CompileScript "PipLog\Interface\GetTileIndexFromName.gek"
	ref OnEditJournalEntryConfirmUDF = CompileScript "PipLog\Interface\Journal\OnEditJournalEntryConfirm.gek"

	; Main

	PrintC "Received click on journal entry with tile param '%z'." (sTileName)

	; Guards

	if eval !(MenuMode 1023)
		PrintC "Cannot edit journal entry, incompatible menu mode %g (expected: 1023)." (GetActiveMenuMode)
		return
	endif

	short iViewMode = Player.AuxiliaryVariableGetFloat "*PLC_iViewMode"

	if iViewMode != 3
		PrintC "Cannot edit journal entry, incompatible view mode %g (expected: 3)." iViewMode
		return
	endif

	; State

	array_var aJournalEntries = (Call GetJournalEntriesUDF)
	short iNumJournalEntries = Ar_Size aJournalEntries
	short iEntryIndex = Call GetTileIndexFromNameUDF sTileName

	; Main

	if eval (iNumJournalEntries == -1) || (iEntryIndex < 0) || (iEntryIndex >= iNumJournalEntries)
		PrintC "Cannot edit journal entry, could not resolve valid entry index %g from '%z'." iEntryIndex sTileName

		Sv_Destruct sActiveComponentPath
		let aJournalEntry := Ar_Null

		return
	endif

	array_var aJournalEntry = aJournalEntries[iEntryIndex]
	string_var sJournalEntryText = aJournalEntry["text"]
	string_var sEntryPrompt = Sv_Construct "Editing Journal Entry #%g:" (iEntryIndex + 1)

	Player.AuxiliaryVariableSetFloat "*PLC_iEditEntryIndex" iEntryIndex

	ShowTextInputMenu OnEditJournalEntryConfirmUDF 700 500 ($sEntryPrompt)
	SetTextInputString "%z" sJournalEntryText

	; Clean-Up

	Sv_Destruct sActiveComponentPath, sJournalEntryId, sJournalEntryText, sEntryPrompt
	let aJournalEntry := Ar_Null

end
