begin function {}

	; Reads holiday definitions from the holidays JSON config file.
	; Returns a positional array of event stringmaps, each with "id", "date", and "name" fields.
	; Returns an empty array if the JSON file could not be loaded.
	; Caller is responsible for Ar_Null on the returned array.

	; UDFs

	ref CreateEventUDF = CompileScript "PipLog\Event\CreateEvent.gek"

	; Main

	array_var aEvents = Ar_Construct "array"

	; Read from File

	array_var aEntries = ReadFromJSON "data\config\PipLog\events\holidays.json" "" 0 0

	if eval !aEntries || aEntries == Ar_Null
		Print "Could not load holiday events from file 'data\config\PipLog\events\holidays.json', file could not be loaded."
		SetFunctionValue aEvents
		return
	endif

	short iNumEntries = Ar_Size aEntries

	if iNumEntries == -1
		Print "Could not load holiday events from file 'data\config\PipLog\events\holidays.json', file contains no usable entries."
		SetFunctionValue aEvents
		return
	else
		PrintC "Processing %g holiday events from config file." iNumEntries
	endif

	; Create Events

	short iIndex = 0

	while iIndex < iNumEntries
		array_var aEntry = aEntries[iIndex]

		if eval (Ar_Size aEntry) == -1
			PrintC "Could not read and process holiday event at index %g, invalid entry." iIndex
			break
		endif

		string_var sDate = aEntry["date"]
		string_var sName = aEntry["name"]

		array_var aEvent = (Call CreateEventUDF sDate sName)

		; PrintC "Would have added holiday event at index %g, id '%z', date '%z', name '%z'." iIndex (aEvent["id"]) (aEvent["date"]) (aEvent["name"])

		Ar_Append aEvents, aEvent

		let iIndex += 1

		let aEvent := Ar_Null
		let aEntry := Ar_Null
		
		Sv_Destruct sDate, sName
	loop

	SetFunctionValue aEvents

	; Clean-Up

	let aEntries := Ar_Null

end
