begin function { short iYear }

	; Returns the Gregorian date of Easter Sunday for the given year as a string.
	; Return format: string "YYYY-MM-DD" (zero-padded, 1-indexed month)
	; Caller is responsible for Sv_Destruct on the returned string.

	; UDFs

	ref GetStorageDateStringUDF = CompileScript "PipLog\DateTime\GetStorageDateString.gek"

	; Main

	if iYear < 1
		SetFunctionValue ""
		return
	endif

	; Meeus/Jones/Butcher Gregorian computus.
	short iGoldenNumber = iYear % 19
	short iCentury = iYear / 100
	short iYearOfCentury = iYear % 100
	short iLeapCentury = iCentury / 4
	short iCenturyRemainder = iCentury % 4
	short iCorrection = (iCentury + 8) / 25
	short iMoonCorrection = (iCentury - iCorrection + 1) / 3
	short iEpact = (19 * iGoldenNumber + iCentury - iLeapCentury - iMoonCorrection + 15) % 30
	short iLeapYearOfCentury = iYearOfCentury / 4
	short iYearRemainder = iYearOfCentury % 4
	short iWeekdayOffset = (32 + 2 * iCenturyRemainder + 2 * iLeapYearOfCentury - iEpact - iYearRemainder) % 7
	short iPaschalCorrection = (iGoldenNumber + 11 * iEpact + 22 * iWeekdayOffset) / 451
	short iDateIndex = iEpact + iWeekdayOffset - 7 * iPaschalCorrection + 114

	short iEasterMonth = (iDateIndex / 31) - 1
	short iEasterDay = (iDateIndex % 31) + 1

	array_var aEasterDate = Ar_List iYear, iEasterMonth, iEasterDay
	string_var sEasterDate = (Call GetStorageDateStringUDF aEasterDate)
	SetFunctionValue sEasterDate

	; Clean-Up

	let aEasterDate := Ar_Null

end
