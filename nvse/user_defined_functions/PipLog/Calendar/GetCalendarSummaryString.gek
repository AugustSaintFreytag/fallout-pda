begin function { string_var sDate }

	; Compiles the display notes string for the given date.
	; Includes formatted date header, events, completed quests, and misc stats.
	; sDate is in YYYY-MM-DD format (1-indexed month, zero-padded).
	; Caller is responsible for Sv_Destruct on the returned string.

	; UDFs

	ref ParseStorageDateToComponentsUDF = CompileScript "PipLog\DateTime\ParseStorageDateToComponents.gek"
	ref GetEventsForDateUDF = CompileScript "PipLog\Event\GetEventsForDate.gek"
	ref GetPlayerStatValuesForDateUDF = CompileScript "PipLog\Stats\GetPlayerStatValuesForDate.gek"
	ref GetStorageDateStringUDF = CompileScript "PipLog\DateTime\GetStorageDateString.gek"
	ref GetVerbalDateStringUDF = CompileScript "PipLog\DateTime\GetVerbalDateString.gek"

	; State

	array_var aDate = (Call ParseStorageDateToComponentsUDF sDate)

	if eval aDate == Ar_Null
		PrintC "Could not formulate calendar summary string for invalid date '%z'." sDate
		return
	endif

	short iYear = aDate[0]
	short iMonth = aDate[1]
	short iDay = aDate[2]

	short bHasEvents = 0
	short bHasQuests = 0
	short bHasStats = 0

	; Main

	string_var sDateHeader = (Call GetVerbalDateStringUDF aDate)
	string_var sResult = Sv_Construct "%z%r" sDateHeader

	Sv_Destruct sDateHeader

	; Events

	array_var aEvents = (Call GetEventsForDateUDF aDate)

	if eval (Ar_Size aEvents) > 0
		let bHasEvents := 1
		let sResult += "%rEvents:%r"

		foreach (array_var aElement) <- aEvents
			array_var aEvent = aElement["value"]
			string_var sEventName = aEvent["name"]

			let sResult += $sEventName
			let sResult += "%r"

			Sv_Destruct sEventName
		loop
	endif

	let aEvents := Ar_Null

	; Quests

	array_var aQuestStats = Player.AuxStringMapArrayGetAsArray "PLC_aPlayerQuestStats"

	if eval (Ar_Size aQuestStats) != -1
		string_var sDate = (Call GetStorageDateStringUDF aDate)

		if eval (Ar_HasKey aQuestStats, sDate)
			string_var sQuestList = aQuestStats[sDate]
			array_var aQuestIds = Sv_Split sQuestList, ","

			foreach (array_var aElement) <- aQuestIds
				string_var sQuestId = aElement["value"]

				if eval !bHasQuests
					let sResult += "%rQuests:%r"
					let bHasQuests := 1
				endif

				ref rQuest = (StringToRef sQuestId)

				if eval (IsFormValid rQuest)
					string_var sQuestName = GetName rQuest
					let sResult += $sQuestName
					let sResult += "%r"
					Sv_Destruct sQuestName
				else
					let sResult += $sQuestId
					let sResult += "%r"
				endif
			loop

			Sv_Destruct sQuestList
			let aQuestIds := Ar_Null
		endif

		Sv_Destruct sDate
	endif

	let aQuestStats := Ar_Null

	; Misc Stats

	array_var aStats = (Call GetPlayerStatValuesForDateUDF aDate)

	foreach array_var aElement <- aStats
		string_var sStatCode = aElement["key"]
		short iNumStatEvents = aElement["value"]

		if eval !bHasStats
			let sResult += "%rStats:%r"
			let bHasStats := 1
		endif

		string_var sIniKey = Sv_Construct "Stats:%z" sStatCode
		string_var sStatName = GetINIString ($sIniKey) "PipLog\stats\stats.ini" ($sStatCode)

		let sResult += $sStatName
		let sResult += ": "
		let sResult += $iNumStatEvents
		let sResult += "%r"

		Sv_Destruct sStatCode, sIniKey, sStatName
	loop

	; Return

	if eval (!bHasEvents) && (!bHasQuests) && (!bHasStats)
		let sResult += "%rNo events.%r"
	endif

	SetFunctionValue sResult

	; Clean-Up

	let aDate := Ar_Null
	let aStats := Ar_Null

end
