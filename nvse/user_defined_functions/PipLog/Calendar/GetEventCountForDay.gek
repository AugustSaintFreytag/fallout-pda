begin function { short iDay, short iMonth, short iYear }

	; Returns the total number of events (all patterns) on the given date.
	; iMonth is 0-indexed.

	; UDFs

	ref GetEventsForDayUDF = CompileScript "PipLog\Calendar\GetEventsForDay.gek"

	; Main

	array_var aEvents = (Call GetEventsForDayUDF iDay iMonth iYear)
	short iCount = Ar_Size aEvents

	SetFunctionValue iCount

	; Clean-Up

	let aEvents := Ar_Null

end
