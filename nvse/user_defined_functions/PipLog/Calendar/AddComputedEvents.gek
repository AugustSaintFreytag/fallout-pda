begin function { short iYear }

	; Computes and registers algorithm-driven calendar events for the given year
	; into the transient global event storage. Intended to be called on game load.
	;
	; Handles: Easter, Thanksgiving, and the player's birthday (if set).
	; Date-variable events (Easter, Thanksgiving) use YYYY-MM-DD format.
	; Birthday uses *-MM-DD to recur annually.
	; All events are registered as global (bIsPlayerEvent = 0) and are transient.

	; UDFs

	ref GetRecurringDatePatternStringUDF = CompileScript "PipLog\DateTime\GetRecurringDatePatternString.gek"
	ref GetEasterDateUDF = CompileScript "PipLog\Calendar\GetEasterDate.gek"
	ref GetThanksgivingDateUDF = CompileScript "PipLog\Calendar\GetThanksgivingDate.gek"
	ref CreateEventUDF = CompileScript "PipLog\Event\CreateEvent.gek"
	ref AddEventsUDF = CompileScript "PipLog\Event\AddEvents.gek"

	; Main

	array_var aEvents = Ar_Construct "array"

	; Easter Event

	if GetINIFloat_Cached "Events:bEaster" "Config\PipLog\PipLog.ini" != 0
		string_var sEasterDate = (Call GetEasterDateUDF iYear)

		if eval sEasterDate != ""
			array_var aEasterEvent = (Call CreateEventUDF sEasterDate "Easter")
			Ar_Append aEvents, aEasterEvent
			let aEasterEvent := Ar_Null
		endif

		Sv_Destruct sEasterDate
	endif

	; Thanksgiving Event

	if GetINIFloat_Cached "Events:bThanksgiving" "Config\PipLog\PipLog.ini" != 0
		string_var sThanksgivingDate = (Call GetThanksgivingDateUDF iYear)

		if eval sThanksgivingDate != ""
			array_var aThanksgivingEvent = (Call CreateEventUDF sThanksgivingDate "Thanksgiving")
			Ar_Append aEvents, aThanksgivingEvent
			let aThanksgivingEvent := Ar_Null
		endif

		Sv_Destruct sThanksgivingDate
	endif

	; Birthday Event

	short bDidSetBirthday = Player.AuxiliaryVariableGetFloat "PLC_bDidSetBirthday"

	if eval bDidSetBirthday
		short iBirthdayMonth = Player.AuxiliaryVariableGetFloat "PLC_iBirthdayMonth"
		short iBirthdayDay = Player.AuxiliaryVariableGetFloat "PLC_iBirthdayDay"
		
		string_var sBirthdayDate = (Call GetRecurringDatePatternStringUDF 1 iBirthdayMonth iBirthdayDay)
		array_var aBirthdayEvent = (Call CreateEventUDF sBirthdayDate "Birthday")

		Ar_Append aEvents, aBirthdayEvent
		
		Sv_Destruct sBirthdayDate
		let aBirthdayEvent := Ar_Null
	endif

	; Add

	PrintC "Adding %g computed events for year %g to calendar." (Ar_Size aEvents) iYear

	Call AddEventsUDF aEvents 0

	; Clean-Up

	let aEvents := Ar_Null

end
