begin function {}

	; Registers each holiday in aHolidays into global event storage.
	; aHolidays should be a positional array of event stringmaps as returned by GetHolidayEvents.

	; UDFs

	ref GetHolidayEventsUDF = CompileScript "PipLog\Calendar\GetHolidayEvents.gek"
	ref AddEventsUDF = CompileScript "PipLog\Event\AddEvents.gek"

	; Main

	array_var aHolidayEvents = (Call GetHolidayEventsUDF)

	PrintC "Adding %g holiday events to calendar." (Ar_Size aHolidayEvents)

	Call AddEventsUDF aHolidayEvents 0

	; Clean-Up

	let aHolidayEvents := Ar_Null

end
