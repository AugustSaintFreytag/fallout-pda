begin function {  }

	; Registers each holiday in aHolidays into global event storage.
	; aHolidays should be a positional array of event stringmaps as returned by GetHolidays.

	; UDFs

	ref GetHolidaysUDF = CompileScript "PipLog\Calendar\GetHolidays.gek"
	ref AddEventUDF = CompileScript "PipLog\Event\AddEvent.gek"

	; Main

	array_var aHolidays = (Call GetHolidaysUDF)

	foreach array_var aElement <- aHolidays
		array_var aHolidayEvent = aElement["value"]
		Call AddEventUDF aHolidayEvent 0
	loop

	; Clean-Up

	let aHolidays := Ar_Null

end
