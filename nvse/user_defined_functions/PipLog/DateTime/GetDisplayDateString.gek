begin function { short iYear, short iMonth, short iDay }

	; Returns a zero-padded date string intended for display to the player.
	; Example: GetDateString 2277 0 20 "-" -> "20.01.2077"

	; UDFs

	ref GetPaddedIntUDF = CompileScript "PipLog\Utils\GetPaddedInt.gek"

	; Formatting

	string_var sYear = Call GetPaddedIntUDF iYear
	string_var sMonth = Call GetPaddedIntUDF (iMonth + 1)
	string_var sDay = Call GetPaddedIntUDF iDay

	string_var sResult = $sDay + "." + $sMonth + "." + $sYear
	
	SetFunctionValue sResult

	; Clean-Up

	Sv_Destruct sYear, sMonth, sDay

end
