begin function {}

	; Returns the current in-game timestamp in storage format: yyyy-mm-dd hh:mm:ss.

	; UDFs

	ref GetStorageDateTimeStringUDF = CompileScript "PipLog\DateTime\GetStorageDateTimeString.gek"

	; Main

	float fCurrentTime = GetCurrentTime
	short iHour = fCurrentTime
	float fMinute = (fCurrentTime - iHour) * 60
	short iMinute = fMinute
	short iSecond = (fMinute - iMinute) * 60

	array_var aDate = Ar_List GameYear, GameMonth, GameDay
	string_var sDateTime = (Call GetStorageDateTimeStringUDF aDate iHour iMinute iSecond)

	SetFunctionValue sDateTime

	let aDate := Ar_Null

end
