begin function { array_var aDate }

	; Returns a zero-padded date string intended for storage.
	; aDate is [year, 0-indexed month, day]; output month is 1-indexed.
	; Example: GetStorageDateString (Ar_List 2277 0 20) -> "2277-01-20"

	; UDFs

	ref GetPaddedIntUDF = CompileScript "PipLog\Utils\GetPaddedInt.gek"

	; Formatting

	short iYear = aDate[0]
	short iMonth = aDate[1]
	short iDay = aDate[2]

	string_var sYear = Call GetPaddedIntUDF iYear 4
	string_var sMonth = Call GetPaddedIntUDF (iMonth + 1) 2
	string_var sDay = Call GetPaddedIntUDF iDay 2

	string_var sResult = Sv_Construct "%z-%z-%z" sYear sMonth sDay

	SetFunctionValue sResult

	; Clean-Up

	Sv_Destruct sYear, sMonth, sDay

end
